<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>AtomicDriftTuner</AssemblyName>
    <RootNamespace>AtomicDriftTuner</RootNamespace>

    <!-- Development/default version values.
         Release packaging overrides Version/AssemblyVersion/FileVersion/
         InformationalVersion explicitly from build-beta-package.ps1. -->
    <ADTVersion Condition="'$(ADTVersion)' == ''">0.8.1-beta.1</ADTVersion>
    <ADTVersionInfoVersion Condition="'$(ADTVersionInfoVersion)' == ''">0.8.1.0</ADTVersionInfoVersion>

    <Version>$(ADTVersion)</Version>
    <AssemblyVersion>$(ADTVersionInfoVersion)</AssemblyVersion>
    <FileVersion>$(ADTVersionInfoVersion)</FileVersion>
    <InformationalVersion>$(ADTVersion)</InformationalVersion>

    <!-- Keep ADT's displayed product version deterministic. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
