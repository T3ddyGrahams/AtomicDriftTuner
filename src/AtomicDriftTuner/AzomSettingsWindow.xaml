<Window x:Class="AtomicDriftTuner.AzomSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Full AZOM Base Settings • ADT"
        Width="1120" Height="860" MinWidth="340" MinHeight="430"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource AtomicTextBoxStyle}"><Setter Property="Margin" Value="0,3,0,8"/><Setter Property="Padding" Value="7"/></Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource AtomicComboBoxStyle}"><Setter Property="Margin" Value="0,3,8,3"/><Setter Property="MinWidth" Value="170"/></Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource AtomicCheckBoxStyle}"><Setter Property="Margin" Value="0,6,0,6"/></Style>
        <Style TargetType="Button" BasedOn="{StaticResource AtomicButtonStyle}"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,5,8,5"/><Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/></Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource AtomicDataGridStyle}"><Setter Property="GridLinesVisibility" Value="Horizontal"/></Style>
    </Window.Resources>
    <Grid x:Name="AzomLayoutRoot" Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="FULL AZOM BASE SETTINGS" FontSize="25" FontWeight="Bold" Visibility="Collapsed"/>
            <TextBlock x:Name="SetupText" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
            <TextBlock Text="TUNED = generated per hardware/car/drift target. PREFERENCE = preserved unless you explicitly include it in a live apply." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        </ScrollViewer>
        <TabControl x:Name="AzomTabs" Grid.Row="1" Margin="0,14,0,12">
            <TabItem Header="Live AZOM"><ScrollViewer x:Name="LiveAzomScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="10">
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="SIMHUB + AZOM LIVE BRIDGE" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="Every Live Apply is serialized and verified against AZOM readback. ADT uses the guarded exact AZOM Base-setting commit path first, then documented SimHub/AZOM action fallbacks only when needed." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,4"/>
                        <TextBlock Text="WRITE SAFETY: stop driving before Apply/Revert • explicit Apply only • one write batch at a time • duplicate live targets are suppressed • direct commits are spaced and verified • interactive writes are coordinated with Apply/Revert." Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Foreground="{DynamicResource FieldLabelBrush}" Text="SimHubWPF.exe"/><TextBox x:Name="SimHubPathBox"/>
                        <WrapPanel>
                            <Button x:Name="AutoDetectSimHubButton" Content="Auto Detect SimHub" Click="AutoDetectSimHub_Click"/>
                            <Button x:Name="BrowseSimHubButton" Content="Browse..." Click="BrowseSimHub_Click"/>
                            <Button x:Name="ReadLiveAzomButton" Content="READ LIVE AZOM" Click="ReadLiveAzom_Click" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold"/>
                        </WrapPanel>
                        <TextBlock x:Name="LiveStatusText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <StackPanel Margin="0,0,0,10">
                    <WrapPanel>
                        <CheckBox x:Name="IncludePreferencesBox" VerticalAlignment="Center" Margin="0,7,16,7" Checked="IncludePreferencesBox_Changed" Unchecked="IncludePreferencesBox_Changed">
                            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" Text="Include preference toggles/settings" TextWrapping="Wrap" Width="180"/>
                        </CheckBox>
                        <Button x:Name="RefreshComparisonButton" Content="Refresh Comparison" Click="RefreshComparison_Click"/>
                        <Button x:Name="ApplySelectedButton" Content="APPLY SELECTED" Click="ApplyLiveAzom_Click" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold"/>
                        <Button x:Name="RevertLastApplyButton" Content="REVERT LAST APPLY" Click="RevertLiveAzom_Click"/>
                    </WrapPanel>
                    <WrapPanel>
                        <Button x:Name="SelectAllDifferencesButton" Content="Select All Differences" Click="SelectAllDifferences_Click"/>
                        <Button x:Name="ClearApplySelectionButton" Content="Clear Selection" Click="ClearApplySelection_Click"/>
                        <ComboBox x:Name="SectionSelectionBox"/>
                        <Button x:Name="SelectSectionButton" Content="Select Section" Click="SelectSection_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="SelectionStatusText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <DataGrid x:Name="LiveComparisonGrid" Height="320" AutoGenerateColumns="False" AlternationCount="2" HeadersVisibility="Column" CanUserAddRows="False" CellEditEnding="LiveComparisonGrid_CellEditEnding"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Apply?" Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsEnabled="{Binding CanApply}"
                                              IsChecked="{Binding IsSelectedForApply, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Click="ApplyRowCheckBox_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Group" Binding="{Binding Group, Mode=OneWay}" IsReadOnly="True" Width="125"/>
                        <DataGridTextColumn Header="Setting" Binding="{Binding DisplayName, Mode=OneWay}" IsReadOnly="True" Width="190"/>
                        <DataGridTextColumn Header="Live" Binding="{Binding CurrentDisplay, Mode=OneWay}" IsReadOnly="True" Width="95"/>
                        <DataGridTextColumn Header="ADT Target" Binding="{Binding TargetDisplay, Mode=OneWay}" IsReadOnly="True" Width="105"/>
                        <DataGridCheckBoxColumn Header="Different" Binding="{Binding IsDifferent, Mode=OneWay}" IsReadOnly="True" Width="75"/>
                        <DataGridCheckBoxColumn Header="Writable" Binding="{Binding CanApply, Mode=OneWay}" IsReadOnly="True" Width="70"/>
                        <DataGridTextColumn Header="Fallback Actions" Binding="{Binding EstimatedActions, Mode=OneWay}" IsReadOnly="True" Width="105"/>
                        <DataGridTextColumn Header="Notes" Binding="{Binding Note, Mode=OneWay}" IsReadOnly="True" Width="*" MinWidth="180"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Safety: ADT saves a pre-apply live snapshot for Revert, writes only changed supported settings, suppresses duplicate live targets, spaces direct commits, verifies readback, and leaves undocumented AZOM controls alone." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Last Batch"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="10">
                <TextBlock x:Name="BatchSummaryText" Text="No live apply/revert batch has run in this session yet." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <DataGrid x:Name="BatchAuditGrid" Height="320" AutoGenerateColumns="False" IsReadOnly="True" AlternationCount="2" CanUserAddRows="False"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Group" Binding="{Binding Group, Mode=OneWay}" Width="115"/>
                        <DataGridTextColumn Header="Setting" Binding="{Binding Setting, Mode=OneWay}" Width="190"/>
                        <DataGridTextColumn Header="Before" Binding="{Binding Before, Mode=OneWay}" Width="90"/>
                        <DataGridTextColumn Header="Target" Binding="{Binding Target, Mode=OneWay}" Width="90"/>
                        <DataGridTextColumn Header="After" Binding="{Binding After, Mode=OneWay}" Width="90"/>
                        <DataGridCheckBoxColumn Header="Verified" Binding="{Binding Verified, Mode=OneWay}" IsReadOnly="True" Width="75"/>
                        <DataGridTextColumn Header="Transport" Binding="{Binding Transport, Mode=OneWay}" Width="150"/>
                        <DataGridTextColumn Header="Note" Binding="{Binding Note, Mode=OneWay}" Width="*" MinWidth="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Core + Effects"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="10">
                <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="CORE SETTINGS  •  TUNED" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" x:Name="CoreText" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,18"/>
                <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="WHEELBASE EFFECTS  •  TUNED / FIXED" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" x:Name="WheelbaseText" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,18"/>
                <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="GAME EFFECTS  •  FIXED STARTING BASELINE" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" x:Name="GameEffectsText" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,18"/>
                <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="PROTECTION  •  TUNED + PREFERENCE" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" x:Name="ProtectionText" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,18"/>
                <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="HIGH SPEED DAMPING  •  TUNED" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" x:Name="HighSpeedText" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,18"/>
                <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="SOFT LIMIT  •  TUNED + PREFERENCE" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" x:Name="SoftLimitText" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,18"/>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Equalizer + Curve"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="10">
                <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="FFB EQUALIZER  •  TUNED" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="ADT only auto-writes the six-band EQ when AZOM reports six-band/legacy firmware. 10-band EQ is read but currently left untouched for frequency safety." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" x:Name="EqualizerText" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,18"/>
                <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="FFB OUTPUT CURVE  •  FIXED LINEAR DRIFT BASELINE" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" x:Name="CurveText" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,10"/>
                <TextBlock Text="Available AZOM curve modes: Linear, S Curve, Exponential, Parabolic. ADT currently recommends Linear for predictable drift response." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Preferences"><ScrollViewer x:Name="AzomPreferencesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="AzomPreferencesPanel" Margin="10" MaxWidth="520" HorizontalAlignment="Stretch">
                <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="GEARSHIFT VIBRATION" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" Text="Shift Intensity (0–5)"/><TextBox x:Name="ShiftIntensityBox"/>
                <CheckBox x:Name="VibrateNeutralBox" Content="Vibrate on Neutral"/>
                <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" Text="Shift Debounce (0–1000 ms)"/><TextBox x:Name="ShiftDebounceBox"/>
                <Separator Margin="0,10"/>
                <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="PROTECTION / SOFT LIMIT" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                <CheckBox x:Name="HandsOffBox" Content="Hands-Off Protection"/>
                <CheckBox x:Name="RetainGameFfbBox"><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" Text="Retain Game FFB at Soft Limit" TextWrapping="Wrap"/></CheckBox>
                <Separator Margin="0,10"/>
                <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="MISCELLANEOUS" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                <CheckBox x:Name="FfbReversalBox" ><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" Text="Force Feedback Reversal" TextWrapping="Wrap"/></CheckBox>
                <CheckBox x:Name="StandbyModeBox" Content="Standby Mode"/>
                <TextBlock Foreground="{DynamicResource FieldLabelBrush}" Text="Standby After (AZOM dropdown value; not exposed for live control)" TextWrapping="Wrap"/><TextBox x:Name="StandbyAfterBox"/>
                <CheckBox x:Name="BaseStatusLedBox" Content="Base Status LED"/>
                <CheckBox x:Name="BluetoothBox" Content="Bluetooth"/>
                <TextBlock Text="ADT does not change these per car. Live Apply ignores them unless you check Include preference toggles/settings." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="All Settings"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock Foreground="{DynamicResource FieldLabelBrush}" x:Name="AllSettingsText" Margin="10" FontFamily="Consolas" TextWrapping="Wrap"/></ScrollViewer></TabItem>
        </TabControl>
        <StackPanel x:Name="AzomSaveFooter" Grid.Row="2">
            <WrapPanel>
                <Button x:Name="SavePreferencesButton" Content="Save Preference Controls" Click="SavePreferences_Click" FontWeight="Bold"/>
                <Button Content="Close" Click="Close_Click"/>
            </WrapPanel>
            <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Window>
