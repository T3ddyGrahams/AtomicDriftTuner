<Window x:Class="AtomicDriftTuner.CarSetupTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="clr-namespace:AtomicDriftTuner.Controls"
        Title="ADT • Review one car setup change" Width="780" Height="830" MinWidth="430" MinHeight="430"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="Button" BasedOn="{StaticResource AtomicButtonStyle}"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,4,8,4"/></Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource AtomicComboBoxStyle}"/>
        <Style x:Key="TestHeading" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SectionHeadingBrush}"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,14,0,6"/></Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="TestBodyScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="YOUR NEXT CAR SETUP CHANGE" Style="{StaticResource TestHeading}" FontSize="22"/>
                <TextBlock x:Name="RunText" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Text="Why ADT suggests a test" Style="{StaticResource TestHeading}"/>
                <TextBlock x:Name="FindingText"/>
                <TextBlock x:Name="ExpectationText" Margin="0,8,0,0"/>
                <Expander Header="What ADT measured" Margin="0,8,0,0" HorizontalContentAlignment="Stretch"><TextBlock x:Name="FindingEvidenceText" Margin="8"/></Expander>
                <TextBlock Text="1. Choose the setup used in this run" Style="{StaticResource TestHeading}"/>
                <TextBlock x:Name="BaselineHelpText"/>
                <TextBox x:Name="BaselinePathBox" IsReadOnly="True" AutomationProperties.Name="Baseline setup file" Margin="0,8,0,4" Padding="8"/>
                <Button x:Name="BrowseBaselineButton" Content="Choose baseline setup…" Click="BrowseBaseline_Click" HorizontalAlignment="Left"/>
                <TextBlock Text="2. Review one adjustment" Style="{StaticResource TestHeading}"/>
                <TextBlock Text="Choose one supported option below. Paired left/right changes count as one axle adjustment. Everything else stays at the baseline values."/>
                <ComboBox x:Name="ChoiceBox" DisplayMemberPath="Name" AutomationProperties.Name="One car setup adjustment to test" SelectionChanged="Choice_Changed" Margin="0,8,0,8"/>
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Current → proposed test" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}"/>
                        <TextBlock x:Name="ChangesText" Text="Choose the matching baseline to see exact values." FontSize="17" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="AdjustmentHelpText" Margin="0,8,0,0"/>
                <layout:SetupComparisonView x:Name="TestComparison"/>
                <TextBlock Text="These are candidates from ADT's existing tuner, checked against this car's supported ranges. The run does not prove which setting caused the behavior. Treat the change as an experiment." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0"/>
                <Expander Header="Saved values and car-defined limits" Margin="0,8,0,0" HorizontalContentAlignment="Stretch"><TextBlock x:Name="DetailsText" Margin="8"/></Expander>
                <TextBlock Text="3. Save or stage — then apply in the pits" Style="{StaticResource TestHeading}"/>
                <TextBlock Text="Save test setup writes a separate file. Load that file in Assetto Corsa's pit setup menu before driving. Alternatively, stage the test and explicitly choose Pit setup → Save &amp; Apply Tune in ADT Companion while stationary in editable pits. Saving or staging alone does not apply it."/>
                <TextBlock Text="4. Record and compare" Style="{StaticResource TestHeading}"/>
                <TextBlock Text="Return to the dashboard, confirm the actual loaded setup, and record the same section with similar driving and conditions. Keep your other car and FFB settings fixed. Stop and save, then use Before / After against this baseline and add how the car felt."/>
                <TextBlock Text="Keep the change only if repeated runs and your feedback support it. If it feels worse, reload the baseline; it is preserved." Margin="0,8,0,12"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="TestStatusText" Text="No setup or game settings have changed." Margin="0,0,0,6"/>
            </ScrollViewer>
            <WrapPanel>
                <Button x:Name="SaveTestButton" Content="Save test setup…" Click="SaveTest_Click" IsEnabled="False" FontWeight="Bold"/>
                <Button x:Name="StageTestButton" Content="Stage test for in-game pits" Click="StageTest_Click" IsEnabled="False"/>
                <Button Content="Close" Click="Close_Click"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
