<Window x:Class="AtomicDriftTuner.CarSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atomic Drift Tuner - Assetto Corsa Car Setup" Width="1260" Height="980"
        MinWidth="940" MinHeight="720" Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource AtomicTextBoxStyle}"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,4,0,8"/></Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource AtomicComboBoxStyle}"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,4,0,8"/></Style>
        <Style TargetType="Button" BasedOn="{StaticResource AtomicButtonStyle}"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ASSETTO CORSA CAR SETUP TUNER" FontSize="24" FontWeight="Bold" Visibility="Collapsed"/>
            <TextBlock x:Name="CarSummaryText" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,14" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Baseline saved setup (.ini)" FontWeight="Bold"/>
                    <ComboBox x:Name="BaselineBox" SelectionChanged="BaselineBox_SelectionChanged"/>
                    <WrapPanel>
                        <Button Content="Refresh AC Setups" Click="RefreshSetups_Click"/>
                        <Button Content="Browse Setup..." Click="BrowseSetup_Click"/>
                        <Button Content="Load Baseline" Click="LoadBaseline_Click" FontWeight="Bold"/>
                    </WrapPanel>
                    <TextBlock x:Name="RangeStatusText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Tuning aggressiveness" FontWeight="Bold"/>
                    <ComboBox x:Name="AggressivenessBox"/>
                    <Button Content="GENERATE CAR SETUP" Click="GenerateSetup_Click" FontWeight="Bold" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>


        <Expander Grid.Row="2" IsExpanded="True" Margin="0,0,0,12">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="DESIRED CAR BEHAVIOR" FontWeight="Bold"/>
                    <TextBlock Text="  • saved per car" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Expander.Header>
            <Border CornerRadius="10" Padding="14" Margin="0,8,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Behavior preset" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" x:Name="BehaviorPresetBox" Margin="0" SelectionChanged="BehaviorPresetBox_SelectionChanged"/>
                        <Button Grid.Column="3" Content="Save for This Car" Click="SaveBehavior_Click" FontWeight="Bold"/>
                        <Button Grid.Column="4" Content="Reset Neutral" Click="ResetBehavior_Click"/>
                    </Grid>

                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,4,22,8">
                            <TextBlock Text="Front-end bite" FontWeight="Bold"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Calmer" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="FrontEndBiteSlider" Minimum="-2" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BehaviorSlider_ValueChanged" Margin="8,0"/>
                                <TextBlock Grid.Column="2" Text="Aggressive" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="FrontEndBiteValueText" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="0,4,0,8">
                            <TextBlock Text="Rear grip" FontWeight="Bold"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Loose" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="RearGripSlider" Minimum="-2" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BehaviorSlider_ValueChanged" Margin="8,0"/>
                                <TextBlock Grid.Column="2" Text="Planted" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="RearGripValueText" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="0,4,22,8">
                            <TextBlock Text="Self-steer speed" FontWeight="Bold"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Slower" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="SelfSteerSlider" Minimum="-2" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BehaviorSlider_ValueChanged" Margin="8,0"/>
                                <TextBlock Grid.Column="2" Text="Faster" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="SelfSteerValueText" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="0,4,0,8">
                            <TextBlock Text="Transition speed" FontWeight="Bold"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Smooth" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="TransitionSlider" Minimum="-2" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BehaviorSlider_ValueChanged" Margin="8,0"/>
                                <TextBlock Grid.Column="2" Text="Quick" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="TransitionValueText" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="0,4,22,8">
                            <TextBlock Text="Angle stability" FontWeight="Bold"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Lively" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="AngleStabilitySlider" Minimum="-2" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BehaviorSlider_ValueChanged" Margin="8,0"/>
                                <TextBlock Grid.Column="2" Text="Stable" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="AngleStabilityValueText" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="0,4,0,8">
                            <TextBlock Text="Throttle steering" FontWeight="Bold"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Less rotation" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="ThrottleSteeringSlider" Minimum="-2" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BehaviorSlider_ValueChanged" Margin="8,0"/>
                                <TextBlock Grid.Column="2" Text="More rotation" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="ThrottleSteeringValueText" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="0,4,22,0">
                            <TextBlock Text="Initiation" FontWeight="Bold"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Progressive" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="InitiationSlider" Minimum="-2" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BehaviorSlider_ValueChanged" Margin="8,0"/>
                                <TextBlock Grid.Column="2" Text="Sharp" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="InitiationValueText" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock x:Name="BehaviorStatusText" Margin="0,8,0,0" FontWeight="Bold" TextWrapping="Wrap"/>

                    <Border Background="{DynamicResource PanelBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="BEHAVIOR BLEND" FontWeight="Bold"/>
                            <TextBlock x:Name="BehaviorBlendPreviewText"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0"/>
                            <TextBlock x:Name="BehaviorBlendResultText"
                                       Foreground="{DynamicResource AccentBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="These sliders describe handling goals, not direct setup values. Atomic now blends overlapping goals with diminishing returns, resolves opposing goals as a compromise, gives the selected session intent priority when it conflicts with a per-car behavior target, and then keeps the same range/click safety rules as the normal setup tuner."
                               Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Expander>

        <DataGrid Grid.Row="3" x:Name="SetupGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                <DataGridTextColumn Header="Parameter" Binding="{Binding Section}" Width="180"/>
                <DataGridTextColumn Header="Current" Binding="{Binding CurrentRaw}" Width="85"/>
                <DataGridTextColumn Header="Recommended" Binding="{Binding RecommendedRaw}" Width="105"/>
                <DataGridTextColumn Header="Delta" Binding="{Binding DeltaText}" Width="70"/>
                <DataGridTextColumn Header="Legal Range" Binding="{Binding RangeText}" Width="120"/>
                <DataGridTextColumn Header="Blend" Binding="{Binding BlendStatus}" Width="145"/>
                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" CornerRadius="10" Padding="14" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="SetupStatusText" Text="Load a baseline setup to begin." FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="Atomic Drift Tuner preserves the baseline file and writes a new setup. Review every recommendation in-game before relying on it." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,12,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Save Atomic Setup..." Click="SaveGenerated_Click" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
