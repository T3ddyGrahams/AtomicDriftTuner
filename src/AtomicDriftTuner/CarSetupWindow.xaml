<Window x:Class="AtomicDriftTuner.CarSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="clr-namespace:AtomicDriftTuner.Controls"
        Title="ADT • Assetto Corsa Car Setup Tuner" Width="1260" Height="980"
        MinWidth="340" MinHeight="430" Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource AtomicTextBoxStyle}"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,4,0,8"/></Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource AtomicComboBoxStyle}"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,4,0,8"/></Style>
        <Style TargetType="Button" BasedOn="{StaticResource AtomicButtonStyle}"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/></Style>
    </Window.Resources>
    <Grid x:Name="CarSetupLayoutRoot" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="CarSetupScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="ASSETTO CORSA CAR SETUP TUNER" FontSize="24" FontWeight="Bold" Visibility="Collapsed"/>
                    <TextBlock x:Name="CarSummaryText" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,14" TextWrapping="Wrap"/>
                </StackPanel>

                <Border CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <layout:AdaptivePanel x:Name="BaselineControlsPanel" MinItemWidth="300" MaxColumns="2" Spacing="12">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="Baseline saved setup (.ini)" FontWeight="Bold"/>
                            <ComboBox x:Name="BaselineBox" SelectionChanged="BaselineBox_SelectionChanged"/>
                            <WrapPanel>
                                <Button Content="Refresh AC Setups" Click="RefreshSetups_Click"/>
                                <Button Content="Browse Setup..." Click="BrowseSetup_Click"/>
                                <Button Content="Load Baseline" Click="LoadBaseline_Click" FontWeight="Bold"/>
                            </WrapPanel>
                            <TextBlock x:Name="RangeStatusText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel x:Name="GenerationControls">
                            <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="Tuning aggressiveness" FontWeight="Bold"/>
                            <ComboBox x:Name="AggressivenessBox" SelectionChanged="AggressivenessBox_SelectionChanged"/>
                            <Button Content="GENERATE CAR SETUP" Click="GenerateSetup_Click" FontWeight="Bold" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"/>
                        </StackPanel>
                    </layout:AdaptivePanel>
                </Border>


                <Expander IsExpanded="True" Margin="0,0,0,12" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <WrapPanel>
                            <TextBlock Foreground="{DynamicResource ExpanderHeaderBrush}" Text="DESIRED CAR BEHAVIOR" FontWeight="Bold"/>
                            <TextBlock Text="  • saved per car" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </WrapPanel>
                    </Expander.Header>
                    <Border CornerRadius="10" Padding="14" Margin="0,8,0,0">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <StackPanel Width="210" Margin="0,0,8,0">
                                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="Behavior preset" FontWeight="Bold"/>
                                    <ComboBox x:Name="BehaviorPresetBox" SelectionChanged="BehaviorPresetBox_SelectionChanged"/>
                                </StackPanel>
                                <Button Content="Reset Neutral" Click="ResetBehavior_Click" VerticalAlignment="Bottom"/>
                            </WrapPanel>

                            <layout:AdaptivePanel x:Name="BehaviorSliders" MinItemWidth="300" MaxColumns="2" Spacing="22">
                                <StackPanel Margin="0,4,0,8">
                                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="Front-end bite" FontWeight="Bold"/>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Calmer" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                        <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="FrontEndBiteSlider" AutomationProperties.Name="Front-end bite" Minimum="-2" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BehaviorSlider_ValueChanged" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Column="1" Text="Aggressive" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="FrontEndBiteValueText" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,4,0,8">
                                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="Rear grip" FontWeight="Bold"/>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Loose" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                        <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="RearGripSlider" AutomationProperties.Name="Rear grip" Minimum="-2" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BehaviorSlider_ValueChanged" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Column="1" Text="Planted" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="RearGripValueText" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,4,0,8">
                                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="Self-steer speed" FontWeight="Bold"/>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Slower" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                        <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="SelfSteerSlider" AutomationProperties.Name="Self-steer speed" Minimum="-2" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BehaviorSlider_ValueChanged" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Column="1" Text="Faster" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="SelfSteerValueText" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,4,0,8">
                                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="Transition speed" FontWeight="Bold"/>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Smooth" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                        <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="TransitionSlider" AutomationProperties.Name="Transition speed" Minimum="-2" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BehaviorSlider_ValueChanged" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Column="1" Text="Quick" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="TransitionValueText" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,4,0,8">
                                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="Angle stability" FontWeight="Bold"/>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Lively" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                        <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="AngleStabilitySlider" AutomationProperties.Name="Angle stability" Minimum="-2" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BehaviorSlider_ValueChanged" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Column="1" Text="Stable" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="AngleStabilityValueText" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,4,0,8">
                                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="Throttle steering" FontWeight="Bold"/>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Less rotation" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                        <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="ThrottleSteeringSlider" AutomationProperties.Name="Throttle steering" Minimum="-2" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BehaviorSlider_ValueChanged" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Column="1" Text="More rotation" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="ThrottleSteeringValueText" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>

                                <StackPanel Margin="0,4,0,8">
                                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="Initiation" FontWeight="Bold"/>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Progressive" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                        <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="InitiationSlider" AutomationProperties.Name="Initiation sharpness" Minimum="-2" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BehaviorSlider_ValueChanged" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Column="1" Text="Sharp" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="InitiationValueText" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </layout:AdaptivePanel>

                            <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" x:Name="BehaviorStatusText" Margin="0,8,0,0" FontWeight="Bold" TextWrapping="Wrap"/>

                            <Border Background="{DynamicResource PanelBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="BEHAVIOR BLEND" FontWeight="Bold"/>
                                    <TextBlock x:Name="BehaviorBlendPreviewText"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                    <TextBlock x:Name="BehaviorBlendResultText"
                                               Foreground="{DynamicResource AccentBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="These sliders describe handling goals, not direct setup values. ADT blends overlapping goals with diminishing returns, resolves opposing goals as a compromise, gives the selected session intent priority when it conflicts with a per-car behavior target, and then keeps the same range/click safety rules as the normal setup tuner."
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Expander>

                <DataGrid x:Name="SetupGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="300"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                        <DataGridTextColumn Header="Parameter" Binding="{Binding Section}" Width="180"/>
                        <DataGridTextColumn Header="Current" Binding="{Binding CurrentRaw}" Width="85"/>
                        <DataGridTextColumn Header="Recommended" Binding="{Binding RecommendedRaw}" Width="105"/>
                        <DataGridTextColumn Header="Delta" Binding="{Binding DeltaText}" Width="70"/>
                        <DataGridTextColumn Header="Legal Range" Binding="{Binding RangeText}" Width="120"/>
                        <DataGridTextColumn Header="Blend" Binding="{Binding BlendStatus}" Width="145"/>
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" MinWidth="180"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="ADT preserves the loaded baseline and writes a separate setup file. Review every recommendation in-game before relying on it." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="CarSetupSaveFooter" Grid.Row="1" CornerRadius="10" Padding="10" Margin="0,12,0,0" Background="{DynamicResource PanelBrush}">
            <StackPanel>
                <WrapPanel>
                    <Button x:Name="SaveBehaviorButton" Content="Save Desired Behavior" Click="SaveBehavior_Click" FontWeight="Bold" ToolTip="Save the desired behavior sliders for this car."/>
                    <Button x:Name="SaveGeneratedButton" Content="Save AC Setup File..." Click="SaveGenerated_Click" FontWeight="Bold" IsEnabled="False" ToolTip="Write the generated recommendations as a separate Assetto Corsa setup file."/>
                </WrapPanel>
                <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" x:Name="SetupStatusText" Text="Load a baseline setup to begin." FontWeight="Bold" TextWrapping="Wrap"/>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Window>
