<UserControl x:Class="AtomicDriftTuner.Controls.ColorWheelPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="292" Height="355">
    <StackPanel>
        <Canvas x:Name="WheelCanvas" Width="270" Height="270"
                HorizontalAlignment="Center"
                Cursor="Cross"
                MouseLeftButtonDown="WheelCanvas_MouseLeftButtonDown"
                MouseMove="WheelCanvas_MouseMove"
                MouseLeftButtonUp="WheelCanvas_MouseLeftButtonUp">
            <Image x:Name="WheelImage" Width="260" Height="260" Canvas.Left="5" Canvas.Top="5"/>
            <Ellipse x:Name="Marker" Width="14" Height="14"
                     Stroke="White" StrokeThickness="2"
                     Fill="Transparent" IsHitTestVisible="False"/>
        </Canvas>
        <TextBlock Text="Brightness" Margin="4,8,4,0"/>
        <Slider x:Name="ValueSlider" Minimum="5" Maximum="100" Value="100"
                Margin="4,2,4,8" ValueChanged="ValueSlider_ValueChanged"/>
        <Grid Margin="4,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="Swatch" Width="34" Height="28" BorderThickness="1"
                    BorderBrush="{DynamicResource ComboBoxBorderBrush}" CornerRadius="4"/>
            <TextBlock Grid.Column="1" x:Name="HexText" VerticalAlignment="Center"
                       FontFamily="Consolas" FontSize="14" Margin="8,0,0,0"/>
        </Grid>
    </StackPanel>
</UserControl>
