<UserControl x:Class="AtomicDriftTuner.Controls.GoalFeedbackView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="FeedbackAnswerStyle" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource CheckBoxTextBrush}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="RadioButton">
      <Border x:Name="FocusBorder" BorderBrush="Transparent" BorderThickness="1" Padding="3" CornerRadius="3">
       <StackPanel Orientation="Horizontal">
        <Grid Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center">
         <Ellipse Stroke="{DynamicResource CheckBoxBorderBrush}" Fill="{DynamicResource CheckBoxBackgroundBrush}" StrokeThickness="1.5"/>
         <Ellipse x:Name="Selection" Width="10" Height="10" Fill="{DynamicResource CheckBoxCheckMarkBrush}" Visibility="Collapsed"/>
        </Grid>
        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
       </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True"><Setter TargetName="Selection" Property="Visibility" Value="Visible"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </UserControl.Resources>
 <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,10">
  <StackPanel>
   <TextBlock Text="Quick driver review" Foreground="{DynamicResource SectionHeadingBrush}" FontWeight="Bold" FontSize="18" TextWrapping="Wrap"/>
   <TextBlock x:Name="ContextText" Foreground="{DynamicResource FieldLabelBrush}" TextWrapping="Wrap" Margin="0,6,0,8"/>
   <StackPanel x:Name="Form">
    <TextBlock Text="Compared with the baseline: choose one answer per question. Better means closer to what you wanted, not simply more angle or faster movement." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <StackPanel x:Name="QuestionsPanel"/>
    <TextBlock Text="Did a new problem appear, or did control become worse?" Foreground="{DynamicResource SectionHeadingBrush}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,4"/>
    <WrapPanel x:Name="ProblemPanel"/>
    <TextBlock Text="Anything else you noticed? (optional)" Foreground="{DynamicResource FieldLabelBrush}" TextWrapping="Wrap" Margin="0,8,0,4"/>
    <TextBox x:Name="NotesBox" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55" MaxHeight="150" VerticalScrollBarVisibility="Auto" TextChanged="NotesChanged" AutomationProperties.Name="Quick review notes"/>
    <TextBlock x:Name="ActionText" Foreground="{DynamicResource SectionHeadingBrush}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,12,0,4"/>
    <TextBlock x:Name="GuidanceText" Foreground="{DynamicResource FieldLabelBrush}" TextWrapping="Wrap"/>
    <WrapPanel Margin="0,10,0,0">
     <Button x:Name="SaveButton" Content="Save quick review" Click="SaveClicked" Margin="0,0,8,8"/>
     <Button x:Name="ClearButton" Content="Clear draft answers" Click="ClearClicked" Margin="0,0,8,8"/>
     <Button x:Name="NextTestButton" Content="Review next supported test" Click="NextClicked" Margin="0,0,8,8" Visibility="Collapsed"/>
    </WrapPanel>
    <TextBlock x:Name="SaveStatus" Foreground="{DynamicResource SecondaryTextBrush}" Text="Answers remain a draft until you save. Saving a review does not apply or revert settings." TextWrapping="Wrap"/>
   </StackPanel>
  </StackPanel>
 </Border>
</UserControl>
