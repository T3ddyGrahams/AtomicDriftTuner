<Window x:Class="AtomicDriftTuner.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atomic Drift Tuner - System Diagnostics"
        Width="1040" Height="720"
        MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="SYSTEM DIAGNOSTICS" FontSize="24" FontWeight="Bold" Visibility="Collapsed"/>
            <TextBlock x:Name="SummaryText"
                       Text="Checking this PC..."
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,12"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  x:Name="DiagnosticsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="120"/>
                <DataGridTextColumn Header="Area" Binding="{Binding Area, Mode=OneWay}" Width="150"/>
                <DataGridTextColumn Header="Check" Binding="{Binding Check, Mode=OneWay}" Width="190"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Value, Mode=OneWay}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="2" Margin="0,14,0,0" HorizontalAlignment="Right">
            <Button Content="Refresh" Click="Refresh_Click" Padding="14,8" Margin="0,0,8,0"/>
            <Button Content="Copy Diagnostics" Click="Copy_Click" Padding="14,8" Margin="0,0,8,0"/>
            <Button Content="Export Support Package" Click="Export_Click" Padding="14,8" FontWeight="Bold"/>
        </WrapPanel>
    </Grid>
</Window>
