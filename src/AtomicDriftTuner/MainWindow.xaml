<Window x:Class="AtomicDriftTuner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ADT • Atomic Drift Tuner • Workflow UI Sandbox"
        Width="1540" Height="960" MinWidth="1180" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="SoftAccentBrush" Color="#1700CFE8" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#56D364" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F2CC60" />

        <Style TargetType="TextBox" BasedOn="{StaticResource AtomicTextBoxStyle}">
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource AtomicComboBoxStyle}">
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="34" />
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="CardKicker" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="InsetPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="13,10" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style x:Key="ActiveNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SoftAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style x:Key="WorkflowStepCard" TargetType="Border" BasedOn="{StaticResource InsetPanel}">
            <Setter Property="Padding" Value="13" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinHeight" Value="118" />
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="18,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="ADT" FontSize="26" FontWeight="Black"
                           FontStyle="Italic" Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ATOMIC DRIFT TUNER" FontSize="13" FontWeight="Bold" />
                    <TextBlock Text="TUNE  •  ANALYZE  •  PERFECT" FontSize="9"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>

                <Border Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource SoftAccentBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        CornerRadius="5" Padding="9,4">
                    <TextBlock Text="TUNING WORKFLOW • v0.8.1 BETA" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                </Border>

                <Button Grid.Column="3" Content="—" Style="{StaticResource WindowButtonStyle}"
                        Click="Minimize_Click" />
                <Button Grid.Column="4" Content="□" Style="{StaticResource WindowButtonStyle}"
                        Click="Maximize_Click" />
                <Button Grid.Column="5" Content="×" Style="{StaticResource WindowButtonStyle}"
                        FontSize="20" Click="Close_Click" />
            </Grid>
        </Border>

        <!-- Main shell -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12,14,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="TUNING FLOW" Style="{StaticResource LabelText}" Margin="12,0,0,8" />
                        <Button x:Name="DashboardNavButton" Content="⌂   Dashboard" Style="{StaticResource ActiveNavButtonStyle}" Click="ReturnToDashboard_Click" />
                        <Button x:Name="AzomNavButton" Content="③   Tune / AZOM" Style="{StaticResource NavButtonStyle}" Click="OpenAzomSettings_Click" />
                        <Button x:Name="CarSetupNavButton" Content="⑥   AC Setup" Style="{StaticResource NavButtonStyle}" Click="OpenCarSetup_Click" />
                        <Button x:Name="TelemetryNavButton" Content="④   Drive / Telemetry" Style="{StaticResource NavButtonStyle}" Click="OpenTelemetry_Click" />
                        <Button x:Name="AssistantNavButton" Content="⑤   Refine Tune" Style="{StaticResource NavButtonStyle}" Click="OpenTuningAssistant_Click" />
                        <Button x:Name="ShareNavButton" Content="↗   Share Codes" Style="{StaticResource NavButtonStyle}" Click="OpenShareCodes_Click" />
                        <Button x:Name="RemoteNavButton" Content="▣   Remote / iPhone" Style="{StaticResource NavButtonStyle}" Click="OpenRemote_Click" />

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,13" />
                        <TextBlock Text="SYSTEM" Style="{StaticResource LabelText}" Margin="12,0,0,8" />
                        <Button x:Name="DiagnosticsNavButton" Content="✓   Diagnostics" Style="{StaticResource NavButtonStyle}" Click="OpenDiagnostics_Click" />
                        <Button x:Name="SetupNavButton" Content="⚙   Setup &amp; Paths" Style="{StaticResource NavButtonStyle}" Click="OpenSetup_Click" />
                        <Button x:Name="AppearanceNavButton" Content="◐   Appearance" Style="{StaticResource NavButtonStyle}" Click="OpenAppearance_Click" />
                        <Button x:Name="UpdatesNavButton" Content="↓   Updates" Style="{StaticResource NavButtonStyle}" Click="OpenUpdates_Click" />
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Border Style="{StaticResource InsetPanel}" Padding="11" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="CONNECTION" Style="{StaticResource LabelText}" />
                                <TextBlock x:Name="RemoteStatusText" Text="Remote: OFF"
                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Same roads. Different lines." FontSize="10"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dashboard -->
            <Grid Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
                <ScrollViewer x:Name="DashboardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,18,20,24">

                        <!-- Page heading -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Dashboard" FontSize="27" FontWeight="Bold" />
                                <TextBlock Text="Follow the drift-tuning loop from car detection through refinement and final AC setup."
                                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Content="Open Telemetry" Style="{StaticResource ModernButtonStyle}" Click="OpenTelemetry_Click" />
                                <Button Content="Generate Tune" Style="{StaticResource PrimaryButtonStyle}" Click="Generate_Click" />
                                <Button Content="Save Profile" Style="{StaticResource ModernButtonStyle}" Click="Save_Click" />
                                <Button Content="Load Profile" Style="{StaticResource ModernButtonStyle}" Click="Load_Click" Margin="0" />
                            </WrapPanel>
                        </Grid>

                        <!-- Guided tuning workflow -->
                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="ADT TUNING LOOP" Style="{StaticResource CardKicker}" />
                                        <TextBlock Text="From detected car to refined drift tune" Style="{StaticResource SectionTitle}" Margin="0,3,0,0" />
                                        <TextBlock Text="Work left to right. You can jump into any stage without losing the state of the others."
                                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource SoftAccentBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                        <TextBlock Text="CAR → TARGET → TUNE → DRIVE → REFINE → SETUP" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource WorkflowStepCard}">
                                        <StackPanel>
                                            <TextBlock Text="01" Style="{StaticResource CardKicker}" />
                                            <TextBlock Text="Car &amp; Rig" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,3" />
                                            <TextBlock Text="Confirm the detected car, wheelbase and drift pack." TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,0,0,10" />
                                            <Button Content="Review" Style="{StaticResource ModernButtonStyle}" Click="FocusCarRig_Click" Margin="0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource WorkflowStepCard}">
                                        <StackPanel>
                                            <TextBlock Text="02" Style="{StaticResource CardKicker}" />
                                            <TextBlock Text="Desired Behavior" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,3" />
                                            <TextBlock Text="Tell ADT how you want this car to rotate and self-steer." TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,0,0,10" />
                                            <Button Content="Set Target" Style="{StaticResource ModernButtonStyle}" Click="FocusDesiredBehavior_Click" Margin="0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource WorkflowStepCard}">
                                        <StackPanel>
                                            <TextBlock Text="03" Style="{StaticResource CardKicker}" />
                                            <TextBlock Text="Generate Tune" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,3" />
                                            <TextBlock Text="Build the recommendation from your current car and intent." TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,0,0,10" />
                                            <Button Content="Generate" Style="{StaticResource PrimaryButtonStyle}" Click="Generate_Click" Margin="0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource WorkflowStepCard}">
                                        <StackPanel>
                                            <TextBlock Text="04" Style="{StaticResource CardKicker}" />
                                            <TextBlock Text="Drive &amp; Record" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,3" />
                                            <TextBlock Text="Take it on track and capture what the car is actually doing." TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,0,0,10" />
                                            <Button Content="Telemetry" Style="{StaticResource ModernButtonStyle}" Click="OpenTelemetry_Click" Margin="0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Style="{StaticResource WorkflowStepCard}">
                                        <StackPanel>
                                            <TextBlock Text="05" Style="{StaticResource CardKicker}" />
                                            <TextBlock Text="Refine" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,3" />
                                            <TextBlock Text="Use telemetry and driver feedback to iterate without starting over." TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,0,0,10" />
                                            <Button Content="Refine Tune" Style="{StaticResource ModernButtonStyle}" Click="OpenTuningAssistant_Click" Margin="0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="5" Style="{StaticResource WorkflowStepCard}" Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="06" Style="{StaticResource CardKicker}" />
                                            <TextBlock Text="AC Setup" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,3" />
                                            <TextBlock Text="Turn the refined target into car-level Assetto Corsa setup guidance." TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,0,0,10" />
                                            <Button Content="Open AC Setup" Style="{StaticResource ModernButtonStyle}" Click="OpenCarSetup_Click" Margin="0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Primary dashboard row -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1.05*" />
                            </Grid.ColumnDefinitions>

                            <!-- Current session -->
                            <Border x:Name="CurrentSessionCard" Grid.Column="0" Style="{StaticResource PanelCard}">
                                <StackPanel>
                                    <TextBlock Text="CURRENT SESSION" Style="{StaticResource CardKicker}" />
                                    <TextBlock Text="Car &amp; Hardware" Style="{StaticResource SectionTitle}" Margin="0,3,0,12" />

                                    <TextBlock Text="Wheelbase" Style="{StaticResource LabelText}" />
                                    <ComboBox x:Name="HardwareBox" SelectionChanged="HardwareBox_SelectionChanged" />

                                    <TextBlock Text="Steering wheel / rim" Style="{StaticResource LabelText}" />
                                    <ComboBox x:Name="WheelBox" SelectionChanged="WheelBox_SelectionChanged" />

                                    <TextBlock Text="Drift pack" Style="{StaticResource LabelText}" />
                                    <ComboBox x:Name="PackBox" SelectionChanged="PackBox_SelectionChanged" />

                                    <TextBlock Text="Car" Style="{StaticResource LabelText}" />
                                    <ComboBox x:Name="CarBox" SelectionChanged="CarBox_SelectionChanged" />

                                    <Border Style="{StaticResource InsetPanel}" Margin="0,2,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="ActiveCarStatusText"
                                                       Text="Active AC car: waiting for an on-track session."
                                                       Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="CarSourceText"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10"
                                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Intent / behavior -->
                            <Border x:Name="DriverIntentCard" Grid.Column="2" Style="{StaticResource PanelCard}">
                                <StackPanel>
                                    <TextBlock Text="DRIVER INTENT" Style="{StaticResource CardKicker}" />
                                    <TextBlock Text="Drift Target" Style="{StaticResource SectionTitle}" Margin="0,3,0,12" />
                                    <TextBlock Text="Choose the high-level behavior ADT should prioritize."
                                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <ComboBox x:Name="IntentBox" SelectionChanged="IntentBox_SelectionChanged" />

                                    <Border Style="{StaticResource InsetPanel}" Margin="0,2,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Generated behavior estimate" Style="{StaticResource LabelText}" />
                                            <TextBlock x:Name="BehaviorText" Margin="0,7,0,0"
                                                       FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                                       Text="Generate a tune to see behavior scores." />
                                        </StackPanel>
                                    </Border>
                                    <Button Content="Open Tuning Assistant" Style="{StaticResource PrimaryButtonStyle}"
                                            Click="OpenTuningAssistant_Click" Margin="0,0,0,7" />
                                    <Button Content="Open AC Setup" Style="{StaticResource ModernButtonStyle}"
                                            Click="OpenCarSetup_Click" Margin="0" />
                                </StackPanel>
                            </Border>

                            <!-- Telemetry summary -->
                            <Border Grid.Column="4" Style="{StaticResource PanelCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="TELEMETRY" Style="{StaticResource CardKicker}" />
                                            <TextBlock Text="Live Analysis" Style="{StaticResource SectionTitle}" Margin="0,3,0,12" />
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="5" Padding="8,4"
                                                Background="{StaticResource SoftAccentBrush}" VerticalAlignment="Top">
                                            <TextBlock x:Name="TelemetryConnectionText" Text="OFFLINE" FontSize="9"
                                                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,2,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource InsetPanel}" Margin="0,0,6,6">
                                            <StackPanel>
                                                <TextBlock Text="SPEED" Style="{StaticResource LabelText}" />
                                                <TextBlock x:Name="TelemetrySpeedText" Text="—" Style="{StaticResource MetricValue}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource InsetPanel}" Margin="6,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="SLIP ANGLE" Style="{StaticResource LabelText}" />
                                                <TextBlock x:Name="TelemetrySlipText" Text="—" Style="{StaticResource MetricValue}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,-4,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource InsetPanel}" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="STEERING" Style="{StaticResource LabelText}" />
                                                <TextBlock x:Name="TelemetrySteeringText" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource InsetPanel}" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="THROTTLE / FFB" Style="{StaticResource LabelText}" />
                                                <TextBlock x:Name="TelemetryThrottleFfbText" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Button Content="Open Telemetry Recorder" Style="{StaticResource ModernButtonStyle}"
                                            Click="OpenTelemetry_Click" Margin="0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Generated tune -->
                        <Border x:Name="GeneratedTuneCard" Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="TUNE RECOMMENDATION" Style="{StaticResource CardKicker}" />
                                        <TextBlock Text="Generated Tune" Style="{StaticResource SectionTitle}" Margin="0,3,0,0" />
                                        <TextBlock x:Name="SummaryText"
                                                   Text="Scan AC or choose settings, then generate a tune."
                                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Content="Full AZOM" Style="{StaticResource ModernButtonStyle}" Click="OpenAzomSettings_Click" />
                                        <Button Content="Generate New Tune" Style="{StaticResource PrimaryButtonStyle}" Click="Generate_Click" Margin="0" />
                                    </WrapPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="0.72*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource InsetPanel}">
                                        <StackPanel>
                                            <TextBlock Text="AZOM / MOZA" FontSize="13" FontWeight="Bold" />
                                            <TextBlock x:Name="AzomText" Margin="0,10,0,0" FontFamily="Consolas"
                                                       FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource InsetPanel}">
                                        <StackPanel>
                                            <TextBlock Text="ASSETTO CORSA FFB" FontSize="13" FontWeight="Bold" />
                                            <TextBlock x:Name="AcText" Margin="0,10,0,0" FontFamily="Consolas"
                                                       FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4" Style="{StaticResource InsetPanel}">
                                        <StackPanel>
                                            <TextBlock Text="CAR DATA CONFIDENCE" FontSize="13" FontWeight="Bold" />
                                            <TextBlock x:Name="ConfidenceScoreText"
                                                       Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                                       Margin="0,7,0,8" />
                                            <TextBlock x:Name="ConfidenceText" FontFamily="Consolas" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Calibration -->
                        <Border x:Name="CalibrationCard" Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.38*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="0.62*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ON-TRACK CALIBRATION" Style="{StaticResource CardKicker}" />
                                    <TextBlock Text="Refine by Feel" Style="{StaticResource SectionTitle}" Margin="0,3,0,8" />
                                    <TextBlock x:Name="CalibrationStatusText"
                                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <TextBlock Text="Make small, deliberate changes after driving the generated tune."
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="10"
                                               TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <Button Content="Apply Feedback + Regenerate" Style="{StaticResource PrimaryButtonStyle}"
                                            Click="ApplyCalibration_Click" Margin="0,0,0,7" />
                                    <Button Content="Reset Saved Calibration" Style="{StaticResource ModernButtonStyle}"
                                            Click="ResetCalibration_Click" Margin="0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Self-steer speed" FontWeight="SemiBold" FontSize="12" />
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Too slow" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" x:Name="SelfSteerSlider" Minimum="-2" Maximum="2" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="Too fast" Style="{StaticResource LabelText}" VerticalAlignment="Center" TextAlignment="Right" />
                                    </Grid>

                                    <TextBlock Text="FFB strength" FontWeight="SemiBold" FontSize="12" />
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Too weak" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" x:Name="StrengthSlider" Minimum="-2" Maximum="2" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="Too strong" Style="{StaticResource LabelText}" VerticalAlignment="Center" TextAlignment="Right" />
                                    </Grid>

                                    <TextBlock Text="Steering weight" FontWeight="SemiBold" FontSize="12" />
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Too light" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" x:Name="WeightSlider" Minimum="-2" Maximum="2" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="Too heavy" Style="{StaticResource LabelText}" VerticalAlignment="Center" TextAlignment="Right" />
                                    </Grid>

                                    <TextBlock Text="Detail / texture" FontWeight="SemiBold" FontSize="12" />
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Smooth" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" x:Name="DetailSlider" Minimum="-2" Maximum="2" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="Noisy" Style="{StaticResource LabelText}" VerticalAlignment="Center" TextAlignment="Right" />
                                    </Grid>

                                    <TextBlock Text="Oscillation" FontWeight="SemiBold" FontSize="12" />
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="None" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" x:Name="OscillationSlider" Minimum="0" Maximum="4" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="Severe" Style="{StaticResource LabelText}" VerticalAlignment="Center" TextAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Advanced configuration -->
                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="ADVANCED CONFIGURATION" Style="{StaticResource CardKicker}" />
                                        <TextBlock Text="Hardware, Car Data &amp; Paths" Style="{StaticResource SectionTitle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="System Diagnostics" Style="{StaticResource ModernButtonStyle}"
                                            Click="OpenDiagnostics_Click" Margin="0" VerticalAlignment="Center" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource InsetPanel}">
                                        <StackPanel>
                                            <TextBlock Text="ASSETTO CORSA INSTALL" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" />
                                            <TextBlock Text="Game root (folder containing content\cars)" Style="{StaticResource LabelText}" />
                                            <TextBox x:Name="AcRootBox" />
                                            <WrapPanel Margin="0,0,0,8">
                                                <Button Content="Auto Detect" Style="{StaticResource ModernButtonStyle}" Click="AutoDetectAc_Click" />
                                                <Button Content="Browse..." Style="{StaticResource ModernButtonStyle}" Click="BrowseAc_Click" Margin="0" />
                                            </WrapPanel>
                                            <Button Content="Rescan Installed Cars" Style="{StaticResource PrimaryButtonStyle}" Click="ScanCars_Click" Margin="0,0,0,8" />
                                            <CheckBox x:Name="AutoScanCarsBox"
                                                      Content="Auto-scan installed cars on start / path change"
                                                      IsChecked="True" Click="AutoDetectionSetting_Click" Margin="0,2,0,6" />
                                            <CheckBox x:Name="AutoSelectActiveCarBox"
                                                      Content="Auto-select active AC car + inferred drift pack"
                                                      IsChecked="True" Click="AutoDetectionSetting_Click" Margin="0,0,0,8" />
                                            <TextBlock x:Name="ScanStatusText" Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap" FontSize="10" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource InsetPanel}">
                                        <StackPanel>
                                            <TextBlock Text="HARDWARE DETAILS" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" />
                                            <TextBlock Text="Peak Torque (Nm)" Style="{StaticResource LabelText}" />
                                            <TextBox x:Name="PeakTorqueBox" />
                                            <TextBlock Text="Wheel Diameter (mm)" Style="{StaticResource LabelText}" />
                                            <TextBox x:Name="WheelDiameterBox" />
                                            <TextBlock Text="Wheel Inertia Factor" Style="{StaticResource LabelText}" />
                                            <TextBox x:Name="WheelInertiaBox" />

                                            <TextBlock Text="PACK CONTEXT" FontSize="12" FontWeight="Bold" Margin="0,4,0,7" />
                                            <TextBlock x:Name="PackInfoText" Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap" FontSize="10" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4" Style="{StaticResource InsetPanel}">
                                        <StackPanel>
                                            <TextBlock Text="CAR DATA" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" />
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Mass (kg)" Style="{StaticResource LabelText}" />
                                                    <TextBox x:Name="CarMassBox" />
                                                    <TextBlock Text="Caster (deg)" Style="{StaticResource LabelText}" />
                                                    <TextBox x:Name="CasterBox" />
                                                    <TextBlock Text="Front Tire Width (mm)" Style="{StaticResource LabelText}" />
                                                    <TextBox x:Name="FrontTireBox" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Power (hp)" Style="{StaticResource LabelText}" />
                                                    <TextBox x:Name="CarPowerBox" />
                                                    <TextBlock Text="Steering Lock / side (deg)" Style="{StaticResource LabelText}" />
                                                    <TextBox x:Name="LockBox" />
                                                    <TextBlock Text="Grip" Style="{StaticResource LabelText}" />
                                                    <ComboBox x:Name="GripBox" />
                                                </StackPanel>
                                            </Grid>
                                            <Button Content="Mark Edited Car Data as Verified" Style="{StaticResource ModernButtonStyle}"
                                                    Click="VerifyCarData_Click" Margin="0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Notes / secondary actions -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="0.48*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                                <StackPanel>
                                    <TextBlock Text="TUNING NOTES" Style="{StaticResource CardKicker}" />
                                    <TextBlock Text="Recommendation Notes" Style="{StaticResource SectionTitle}" Margin="0,3,0,9" />
                                    <TextBlock x:Name="NotesText" TextWrapping="Wrap"
                                               Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                                <StackPanel>
                                    <TextBlock Text="QUICK ACTIONS" Style="{StaticResource CardKicker}" />
                                    <TextBlock Text="Tools" Style="{StaticResource SectionTitle}" Margin="0,3,0,10" />
                                    <Button Content="Atomic Share Codes" Style="{StaticResource ModernButtonStyle}" Click="OpenShareCodes_Click" Margin="0,0,0,7" />
                                    <Button Content="Remote / iPhone" Style="{StaticResource ModernButtonStyle}" Click="OpenRemote_Click" Margin="0,0,0,7" />
                                    <Button Content="Customize Appearance" Style="{StaticResource ModernButtonStyle}" Click="OpenAppearance_Click" Margin="0,0,0,7" />
                                    <Button Content="Check Updates" Style="{StaticResource ModernButtonStyle}" Click="OpenUpdates_Click" Margin="0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Embedded tool workspace -->
                <Border x:Name="EmbeddedToolPanel" Visibility="Collapsed"
                        Background="{DynamicResource AppBackgroundBrush}" Panel.ZIndex="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid Margin="18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="⌂  Dashboard" Style="{StaticResource ModernButtonStyle}"
                                        Click="ReturnToDashboard_Click" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="EmbeddedToolTitle" Text="Tool" FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock x:Name="EmbeddedToolSubtitle" Text="ADT workspace"
                                               FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="v0.8.1 BETA" VerticalAlignment="Center"
                                           FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Margin="14" Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                                ClipToBounds="True">
                            <ContentControl x:Name="EmbeddedToolContent"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="●  ADT v0.8.1 Beta • Tuning engines and safety paths active"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Atomic Drift Tuner"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="10"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
