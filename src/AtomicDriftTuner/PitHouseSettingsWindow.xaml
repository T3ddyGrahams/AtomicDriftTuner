<Window x:Class="AtomicDriftTuner.PitHouseSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADT • Wheelbase Settings" Width="1000" Height="800" MinWidth="430" MinHeight="430"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SettingsBody">
                <TextBlock x:Name="HeadingText" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="ContextText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8"/>
                <TextBlock x:Name="HelpText" Foreground="{DynamicResource FieldLabelBrush}" TextWrapping="Wrap" Margin="0,8"/>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,6">
                    <StackPanel>
                        <TextBlock Text="AC in-game FFB — enter separately" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}"/>
                        <TextBlock x:Name="AcValuesText" Foreground="{DynamicResource FieldLabelBrush}" TextWrapping="Wrap" Margin="0,6"/>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="SdkPanel">
                    <TextBlock Text="Optional SDK connection · experimental" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}" TextWrapping="Wrap" Margin="0,8"/>
                    <TextBlock Text="Choose MOZA's SDK_CSharp/x64 folder (x86 for 32-bit ADT). It must contain MOZA_API_C.dll and MOZA_SDK.dll. SDK-compatible Pit House must be installed and running on this PC. Vendor DLLs are not bundled with ADT." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                    <TextBox x:Name="SdkFolderBox" AutomationProperties.Name="MOZA SDK folder" MaxLength="1024" Margin="0,6" TextChanged="SdkFolder_Changed"/>
                    <WrapPanel>
                        <Button x:Name="BrowseButton" Content="Browse SDK folder" Click="Browse_Click" Margin="0,4,8,4"/>
                        <Button x:Name="ReadButton" Content="Read Pit House" Click="Read_Click" Margin="0,4,8,4"/>
                        <Button x:Name="RestoreButton" Content="Review backup to restore" Click="Restore_Click" Margin="0,4,8,4"/>
                    </WrapPanel>
                    <TextBlock Text="Read checks settings only. Select the rows you want to change. A preview expires after two minutes. The SDK reports a device name, not a verified unique serial number: confirm the physical base yourself. Keep AZOM and other tools from writing during this test." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="Recommendations only — no settings have been read or applied." Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,10"/>
                <TextBlock x:Name="PlanTitleText" Text="Generated wheelbase recommendations" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}" TextWrapping="Wrap"/>
                <ItemsControl x:Name="SettingsRows" Margin="0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,5">
                                <DockPanel>
                                    <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="{Binding Label}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource FieldLabelBrush}" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ValuesText}" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,3"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="UnsupportedText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8"/>
                <CheckBox x:Name="ConfirmBaseCheck" Margin="0,8" Checked="Confirm_Changed" Unchecked="Confirm_Changed">
                    <TextBlock Text="The detected base is my selected MOZA wheelbase, the car is stationary, and I have reviewed the selected changes." Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" TextWrapping="Wrap"/>
                </CheckBox>
                <TextBlock x:Name="BackupText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8"/>
            </StackPanel>
        </ScrollViewer>
        <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ApplyButton" Content="Apply selected changes" Click="Apply_Click" IsEnabled="False" Margin="0,4,8,4"/>
            <Button x:Name="CloseButton" Content="Close" Click="Close_Click" Margin="0,4,0,4"/>
        </WrapPanel>
    </Grid>
</Window>
