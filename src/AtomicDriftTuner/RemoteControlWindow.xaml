<Window x:Class="AtomicDriftTuner.RemoteControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADT • Remote Control"
        Width="820"
        Height="700"
        MinWidth="430"
        MinHeight="430"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="Button"
               BasedOn="{StaticResource AtomicButtonStyle}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
        </Style>

        <Style TargetType="TextBox"
               BasedOn="{StaticResource AtomicTextBoxStyle}">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="ADT REMOTE"
                       FontSize="24"
                       FontWeight="Bold"
                       Visibility="Collapsed"/>

            <TextBlock Text="Local/private-network companion. Windows ADT remains authoritative for telemetry, tuning context, Desired Behavior, and all guarded wheelbase writes."
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,12"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      x:Name="RemoteBodyScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="TOUCHSCREEN / SIMHUB CONTROL CENTER" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="1. Start ADT Remote below.&#10;2. On a Pi/tablet, open the other-device address below in its browser. Or install ADT Control Center in SimHub and tap Open ADT on the device.&#10;3. Tap Full screen and enter the pairing code. The page fits landscape, portrait and different screen sizes automatically.&#10;4. Prepare Telemetry Recorder in desktop ADT, then start, stop and save runs from the screen.&#10;&#10;Keep ADT running and both devices on the same home network. AZOM is optional for recording. No resolution changes in the SimHub editor are needed." TextWrapping="Wrap" Margin="0,8,0,10"/>
                        <TextBlock Text="Screen connected to this PC" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,4,0,4"/>
                        <TextBox x:Name="TouchscreenAddressBox" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Touchscreen address on this PC"/>
                        <TextBlock Text="Raspberry Pi / tablet / another device" Foreground="{DynamicResource FieldLabelBrush}" Margin="0,8,0,4"/>
                        <TextBox x:Name="TouchscreenLanAddressBox" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Touchscreen address for another device"/>
                        <WrapPanel>
                            <Button x:Name="CopyTouchscreenAddressButton" Content="COPY PC ADDRESS" Click="CopyTouchscreenAddress_Click"/>
                            <Button x:Name="CopyTouchscreenLanAddressButton" Content="COPY PI / TABLET ADDRESS" Click="CopyTouchscreenLanAddress_Click"/>
                            <Button x:Name="InstallTouchscreenButton" Content="INSTALL SIMHUB DASHBOARD" Click="InstallTouchscreen_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="TouchscreenInstallText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Text="Installs ADT Control Center using this PC's preferred private network address. Other dashboards are preserved. On a Pi/tablet, Open ADT leaves SimHub's fixed canvas so the controls fit this device. Install again if the PC's address or Remote port changes."/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource PanelBrush}"
                        CornerRadius="10"
                        Padding="16"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="SERVER"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock Foreground="{DynamicResource FieldLabelBrush}" x:Name="ServerStatusText"
                                   Text="STOPPED • no remote network listener is active"
                                   Margin="0,5,0,6"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Shared AC telemetry"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,0"/>

                        <TextBlock Foreground="{DynamicResource FieldLabelBrush}" x:Name="TelemetryStatusText"
                                   Text="Checking..."
                                   Margin="0,2,0,10"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Port"
                                   Foreground="{DynamicResource MutedTextBrush}"/>

                        <TextBox x:Name="PortBox"
                                 Text="5190"
                                 Width="120"
                                 MaxLength="5"
                                 HorizontalAlignment="Left"
                                 AutomationProperties.Name="ADT Remote port"/>

                        <WrapPanel>
                            <Button x:Name="StartButton"
                                    Content="START REMOTE"
                                    Click="Start_Click"
                                    FontWeight="Bold"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="{DynamicResource AccentTextBrush}"/>

                            <Button x:Name="StopButton"
                                    Content="STOP"
                                    Click="Stop_Click"
                                    IsEnabled="False"/>
                        </WrapPanel>

                        <TextBlock Text="Windows Firewall may ask for permission the first time ADT opens a local listening port. Use ADT Remote only on a trusted private network."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBrush}"
                        CornerRadius="10"
                        Padding="16"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="PAIR PHONE / BROWSER"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock Text="After the server starts, open one of the active LAN addresses on your phone/browser and enter the current pairing code."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,8"/>

                        <TextBlock Text="Active LAN address"
                                   Foreground="{DynamicResource MutedTextBrush}"/>

                        <TextBox x:Name="AddressBox"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 MinHeight="58"
                                 Text="Start ADT Remote to show active LAN addresses."
                                 AutomationProperties.Name="ADT Remote LAN addresses"/>

                        <WrapPanel>
                            <Button x:Name="CopyAddressButton"
                                    Content="COPY FIRST LAN ADDRESS"
                                    Click="CopyAddress_Click"
                                    IsEnabled="False"/>

                            <Button x:Name="RegeneratePairingButton"
                                    Content="NEW PAIRING CODE"
                                    Click="RegeneratePairing_Click"
                                    IsEnabled="False"/>
                        </WrapPanel>

                        <TextBlock Text="Pairing code"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,10,0,0"/>

                        <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" x:Name="PairingCodeText"
                                   Text="------"
                                   FontFamily="Consolas"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   AutomationProperties.Name="ADT Remote pairing code"/>

                        <TextBlock Text="The displayed code is active only while the server is running. Starting the server or generating a new pairing code rotates the pairing credentials; previously paired browsers must pair again."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBrush}"
                        CornerRadius="10"
                        Padding="16"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="REMOTE WRITE SAFETY"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <CheckBox x:Name="AllowWritesBox"
                                  HorizontalContentAlignment="Stretch"
                                  Click="AllowWrites_Click"
                                  Margin="0,10,0,6"
                                  IsEnabled="False">
                            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" Text="Allow remote AZOM writes for this ADT run"
                                       TextWrapping="Wrap"/>
                        </CheckBox>

                        <TextBlock Text="OFF by default on every server start. ADT Remote exposes only the explicit supported core/wheelbase allow-list; requests remain range-checked, serialized, guarded, and live-readback verified. Generating new pairing credentials or closing this control window turns remote AZOM writes OFF. Closing the control window leaves the server running unless you press STOP. The paired in-game companion can still control recording on this PC."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBrush}"
                        CornerRadius="10"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="IN-GAME COMPANION"
                                   FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Prepare your car, driver and conditions in Telemetry Recorder, then START this server. Open ADT Companion inside Assetto Corsa and pair with the code above. You can start, stop and save recordings and read Your Next Step while ADT is minimized. SimHub and remote AZOM writes are not required. Keep ADT running."
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,16"/>
                        <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="LIVE ACTIVITY"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="ActivityText"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <WrapPanel Grid.Row="2"
                   Margin="0,14,0,0"
                   HorizontalAlignment="Right">
            <Button x:Name="CloseButton"
                    Content="CLOSE"
                    Click="Close_Click"/>
        </WrapPanel>
    </Grid>
</Window>
