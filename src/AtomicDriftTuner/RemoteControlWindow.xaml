<Window x:Class="AtomicDriftTuner.RemoteControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atomic Drift Tuner - Remote / iPhone Test"
        Width="820" Height="700" MinWidth="700" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource AtomicButtonStyle}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource AtomicTextBoxStyle}">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="REMOTE / IPHONE TEST" FontSize="24" FontWeight="Bold" Visibility="Collapsed"/>
            <TextBlock Text="Experimental local-network companion. Windows Atomic remains authoritative for telemetry and all wheelbase writes."
                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="SERVER" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="ServerStatusText" Text="Stopped" Margin="0,5,0,6" TextWrapping="Wrap"/>
                        <TextBlock Text="Shared AC telemetry" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TelemetryStatusText" Text="Checking..." Margin="0,2,0,10" TextWrapping="Wrap"/>
                        <TextBlock Text="Port" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBox x:Name="PortBox" Text="5190" Width="120" HorizontalAlignment="Left"/>
                        <WrapPanel>
                            <Button x:Name="StartButton" Content="START REMOTE" Click="Start_Click" FontWeight="Bold"
                                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"/>
                            <Button x:Name="StopButton" Content="STOP" Click="Stop_Click"/>
                        </WrapPanel>
                        <TextBlock Text="Windows Firewall may ask for permission the first time the local server starts. Private networks only are appropriate for this test."
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="PAIR IPHONE / BROWSER" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="On your iPhone, open one of these addresses in Safari, then enter the pairing code."
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,0,8"/>
                        <TextBlock Text="Address" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBox x:Name="AddressBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="58"/>
                        <WrapPanel>
                            <Button Content="COPY FIRST ADDRESS" Click="CopyAddress_Click"/>
                            <Button Content="NEW PAIRING CODE" Click="RegeneratePairing_Click"/>
                        </WrapPanel>
                        <TextBlock Text="Pairing code" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0"/>
                        <TextBlock x:Name="PairingCodeText" FontFamily="Consolas" FontSize="34" FontWeight="Bold"/>
                        <TextBlock Text="The browser receives a strong session token only after the code is accepted. Pairing credentials rotate whenever the remote server starts or you generate a new code."
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="REMOTE WRITE SAFETY" FontSize="18" FontWeight="Bold"/>
                        <CheckBox x:Name="AllowWritesBox" Content="Allow remote AZOM writes for this Atomic run"
                                  Click="AllowWrites_Click" Margin="0,10,0,6"/>
                        <TextBlock Text="OFF by default on every launch/start. The test remote only exposes a small allow-list of known core/wheelbase numeric settings. Every request is range-checked and passed through Atomic's existing serialized, duplicate/rate-guarded, live-readback-verified AZOM pipeline."
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="LIVE ACTIVITY" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="ActivityText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <WrapPanel Grid.Row="2" Margin="0,14,0,0" HorizontalAlignment="Right">
            <Button Content="CLOSE" Click="Close_Click"/>
        </WrapPanel>
    </Grid>
</Window>
