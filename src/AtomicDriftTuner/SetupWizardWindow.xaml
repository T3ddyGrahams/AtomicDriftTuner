<Window x:Class="AtomicDriftTuner.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atomic Drift Tuner - Setup &amp; Paths"
        Width="940" Height="760"
        MinWidth="780" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="ATOMIC DRIFT TUNER"
                       FontSize="28"
                       FontWeight="Bold"/>
            <TextBlock Text="FIRST-RUN / MACHINE SETUP"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"
                       Margin="0,2,0,0"/>
            <TextBlock x:Name="IntroText"
                       Text="Atomic detects common locations, but every path can be changed. These paths stay on this PC and are not part of shared tuning profiles."
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,18"/>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="SIMHUB" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Choose the folder containing SimHubWPF.exe."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,2,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SimHubPathBox" Margin="0,0,8,0" Padding="8"/>
                        <Button Grid.Column="1" Content="Browse" Click="BrowseSimHub_Click" Padding="14,8"/>
                    </Grid>
                    <TextBlock x:Name="SimHubStatusText" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Auto Detect" Click="DetectSimHub_Click" Padding="14,8" Margin="0,0,8,0"/>
                        <Button Content="Install / Repair Packaged Bridge" Click="InstallBridge_Click" Padding="14,8" Margin="0,0,8,0"/>
                        <Button Content="Refresh Bridge Status" Click="RefreshBridge_Click" Padding="14,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="BridgeStatusText"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="ASSETTO CORSA INSTALL" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Choose the Assetto Corsa folder containing content\cars."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,2,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AcRootBox" Margin="0,0,8,0" Padding="8"/>
                        <Button Grid.Column="1" Content="Browse" Click="BrowseAc_Click" Padding="14,8"/>
                    </Grid>
                    <TextBlock x:Name="AcStatusText" Margin="0,7,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="ASSETTO CORSA USER DATA" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="This is usually the Windows Documents\Assetto Corsa folder. Atomic uses the Windows known-folder location so redirected/OneDrive Documents are supported."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AcDocumentsBox" Margin="0,0,8,0" Padding="8"/>
                        <Button Grid.Column="1" Content="Browse" Click="BrowseAcDocuments_Click" Padding="14,8"/>
                    </Grid>
                    <TextBlock x:Name="AcDocumentsStatusText" Margin="0,7,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource PanelAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,14">
                <TextBlock x:Name="OverallStatusText"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="Use Test Everything before saving. Missing optional integrations do not prevent Atomic from opening."/>
            </Border>

            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Detect All" Click="DetectAll_Click" Padding="16,9" Margin="0,0,8,0"/>
                <Button Content="Test Everything" Click="TestEverything_Click" Padding="16,9" Margin="0,0,8,0"/>
                <Button Content="Save &amp; Continue" Click="Save_Click" Padding="18,9" FontWeight="Bold"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
