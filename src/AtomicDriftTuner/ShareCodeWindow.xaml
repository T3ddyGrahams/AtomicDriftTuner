<Window x:Class="AtomicDriftTuner.ShareCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADT Share Codes"
        Width="900"
        Height="760"
        MinWidth="760"
        MinHeight="620"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="Button"
               BasedOn="{StaticResource AtomicButtonStyle}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <Style TargetType="TextBox"
               BasedOn="{StaticResource AtomicTextBoxStyle}">
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ADT SHARE CODES"
                       FontSize="25"
                       FontWeight="Bold"
                       Visibility="Collapsed"/>

            <TextBlock Text="Portable AT1 code • review first • regenerate locally"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,3,0,8"/>

            <Border Background="{DynamicResource PanelBrush}"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,12">
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}">
                    AT1 codes contain a privacy-limited tuning context plus a recommendation snapshot. They do not contain local file paths,
                    telemetry recordings, calibration history, Discord/remote tokens, credentials, or preference-style AZOM settings.
                    Importing a code never directly applies its AZOM snapshot. ADT validates the shared context and regenerates recommendations
                    locally through the normal Windows tuning engine.
                </TextBlock>
            </Border>
        </StackPanel>

        <TabControl Grid.Row="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}">
            <TabItem Header="CREATE / COPY">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="CURRENT GENERATED TUNE"
                                   FontWeight="Bold"
                                   FontSize="16"/>

                        <TextBlock x:Name="CreateSummaryText"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,4,0,10"/>

                        <TextBox x:Name="GeneratedCodeBox"
                                 Height="250"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 AutomationProperties.Name="Generated ADT share code"/>

                        <TextBlock x:Name="GeneratedStatsText"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,5,0,6"
                                   TextWrapping="Wrap"/>

                        <WrapPanel>
                            <Button x:Name="CopyCodeButton"
                                    Content="COPY SHARE CODE"
                                    Click="CopyCode_Click"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="{DynamicResource AccentTextBrush}"
                                    FontWeight="Bold"/>

                            <Button x:Name="CopyPreviewButton"
                                    Content="COPY PREVIEW"
                                    Click="CopyPreview_Click"/>
                        </WrapPanel>

                        <TextBlock Text="Portable AT1 codes are self-contained. Treat codes from other people as untrusted input: review the decoded preview before loading anything."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="IMPORT">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="PASTE ADT SHARE CODE"
                                   FontWeight="Bold"
                                   FontSize="16"/>

                        <TextBox x:Name="ImportCodeBox"
                                 Height="190"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Margin="0,6,0,8"
                                 AutomationProperties.Name="ADT share code to import"
                                 TextChanged="ImportCodeBox_TextChanged"/>

                        <WrapPanel>
                            <Button Content="DECODE + REVIEW"
                                    Click="Decode_Click"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="{DynamicResource AccentTextBrush}"
                                    FontWeight="Bold"/>

                            <Button Content="PASTE FROM CLIPBOARD"
                                    Click="Paste_Click"/>
                        </WrapPanel>

                        <TextBlock Text="DECODED PREVIEW"
                                   FontWeight="Bold"
                                   Margin="0,12,0,4"/>

                        <TextBox x:Name="PreviewBox"
                                 Height="240"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 AutomationProperties.Name="Decoded ADT share code preview"/>

                        <CheckBox x:Name="ImportBehaviorBox"
                                  Content="Also save the shared Desired Behavior for this car"
                                  Margin="0,12,0,4"/>

                        <TextBlock Text="Off by default. When enabled, the shared bounded Desired Behavior targets are saved locally for the imported car. This is a persistent profile change, but it still does not write AZOM or the wheelbase."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="22,0,0,8"/>

                        <Button x:Name="LoadContextButton"
                                Content="LOAD CONTEXT + REGENERATE LOCALLY"
                                Click="LoadContext_Click"
                                IsEnabled="False"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource AccentTextBrush}"
                                FontWeight="Bold"
                                Height="44"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
