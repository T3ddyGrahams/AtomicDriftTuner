<Window x:Class="AtomicDriftTuner.ShareCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atomic Share Codes • v1 Portable"
        Width="900" Height="760" MinWidth="760" MinHeight="620"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,4,8,4" />
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource AtomicTextBoxStyle}">
            <Setter Property="Padding" Value="8" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ATOMIC SHARE CODES" FontSize="25" FontWeight="Bold" />
            <TextBlock Text="Phase 1 • portable AT1 code • server-backed short IDs come next"
                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,8" />
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}">
                    AT1 codes contain a privacy-limited tuning context plus a recommendation snapshot. They do not contain local file paths,
                    telemetry recordings, calibration history, Discord/remote tokens, credentials, or preference-style AZOM settings.
                    Importing a code never writes to AZOM. Atomic loads the shared context and regenerates the tune locally through the normal Windows tuning engine.
                </TextBlock>
            </Border>
        </StackPanel>

        <TabControl Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
            <TabItem Header="CREATE / COPY">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="CURRENT GENERATED TUNE" FontWeight="Bold" FontSize="16" />
                        <TextBlock x:Name="CreateSummaryText" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,10" />
                        <TextBox x:Name="GeneratedCodeBox" Height="250" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" IsReadOnly="True" FontFamily="Consolas" FontSize="12" />
                        <TextBlock x:Name="GeneratedStatsText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,6" />
                        <WrapPanel>
                            <Button Content="COPY SHARE CODE" Click="CopyCode_Click"
                                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold" />
                            <Button Content="COPY PREVIEW" Click="CopyPreview_Click" />
                        </WrapPanel>
                        <TextBlock Text="The portable AT1 code is intentionally self-contained. A later server step will turn this payload into short IDs such as AT-7K4D2P."
                                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="IMPORT">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="PASTE ATOMIC SHARE CODE" FontWeight="Bold" FontSize="16" />
                        <TextBox x:Name="ImportCodeBox" Height="190" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0,6,0,8" />
                        <WrapPanel>
                            <Button Content="DECODE + REVIEW" Click="Decode_Click"
                                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold" />
                            <Button Content="PASTE FROM CLIPBOARD" Click="Paste_Click" />
                        </WrapPanel>

                        <TextBlock Text="DECODED PREVIEW" FontWeight="Bold" Margin="0,12,0,4" />
                        <TextBox x:Name="PreviewBox" Height="240" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" IsReadOnly="True" FontFamily="Consolas" FontSize="12" />

                        <CheckBox x:Name="ImportBehaviorBox"
                                  Content="Also save the shared Desired Behavior for this car"
                                  Margin="0,12,0,4" />
                        <TextBlock Text="Off by default. When enabled, only the seven bounded Desired Behavior targets (-2..+2) are saved locally. This still does not write AZOM."
                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="22,0,0,8" />

                        <Button x:Name="LoadContextButton" Content="LOAD CONTEXT + REGENERATE LOCALLY"
                                Click="LoadContext_Click" IsEnabled="False"
                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                                FontWeight="Bold" Height="44" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
