<Window x:Class="AtomicDriftTuner.TelemetryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atomic Drift Tuner v0.8.1 UPDATES TEST 1 • Telemetry Recorder"
        Width="1120" Height="780" MinWidth="920" MinHeight="650"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource AtomicButtonStyle}"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Style>
        <Style TargetType="Border" x:Key="Card"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="TELEMETRY RECORDER + DRIFT SESSION ANALYZER" FontSize="24" FontWeight="Bold" Visibility="Collapsed"/>
            <TextBlock x:Name="SetupText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
            <WrapPanel>
                <Button x:Name="ConnectButton" Content="Connect to Assetto Corsa" Click="Connect_Click"/>
                <Button x:Name="RecordButton" Content="Start Recording" Click="Record_Click" FontWeight="Bold" IsEnabled="False"/>
                <Button x:Name="StopButton" Content="Stop + Analyze" Click="Stop_Click" IsEnabled="False"/>
                <Button Content="Save Session" Click="Save_Click" x:Name="SaveButton" IsEnabled="False"/>
                <Button Content="Apply Telemetry Correction" Click="ApplySuggestion_Click" x:Name="ApplyButton" IsEnabled="False"/>
            </WrapPanel>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,12" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="LIVE TELEMETRY" FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="LiveText" FontFamily="Consolas" FontSize="14" Margin="0,8,0,0" Text="Not connected."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="RECORDING" FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="RecordingText" FontFamily="Consolas" FontSize="14" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="HOW DETECTION WORKS" FontSize="18" FontWeight="Bold"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0"
                                       Text="Atomic calculates body slip angle from AC local velocity, uses local yaw rate, and detects drift while speed is at least 20 km/h and absolute body slip is at least 10°. Oscillation, extreme-angle, transition and FFB-clipping flags are heuristics: they are evidence for small corrections, not proof of a setup problem. Save representative sessions so the v0.7 Tuning Assistant can compare them with Desired Behavior."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SESSION ANALYSIS" FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="AnalysisText" FontFamily="Consolas" FontSize="14" Margin="0,8,0,0" Text="Record a session to analyze it."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ASSESSMENT" FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="AssessmentText" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="PROPOSED CALIBRATION DELTA" FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="SuggestionText" FontFamily="Consolas" FontSize="14" Margin="0,8,0,0"/>
                            <TextBlock Text="Applying this changes only Atomic Drift Tuner's saved calibration for the current wheelbase + wheel + pack + car. It does not directly write hardware by itself; use the Full AZOM Settings → Live AZOM page to review/apply generated AZOM changes." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
