<Window x:Class="AtomicDriftTuner.TelemetryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="clr-namespace:AtomicDriftTuner.Controls"
        Title="ADT • Telemetry Recorder"
        Width="1120"
        Height="780"
        MinWidth="430"
        MinHeight="430"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="Button"
               BasedOn="{StaticResource AtomicButtonStyle}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="TelemetryBodyScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock x:Name="RecorderStepsText" Text="Connect → attach setup and confirm context → Record → Stop → Save Session → Review / Compare" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
            <Button x:Name="CompareSavedRunButton" Content="Review / Compare Saved Run" Click="CompareSavedRun_Click" IsEnabled="False" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="TELEMETRY RECORDER + DRIFT SESSION ANALYZER"
                       FontSize="24"
                       FontWeight="Bold"
                       Visibility="Collapsed"/>

            <TextBlock x:Name="SetupText"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,10"/>

            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,4,0,12"
                       TextWrapping="Wrap"/>
            <Border Style="{StaticResource Card}">
                <StackPanel x:Name="RunCapturePanel">
                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="DRIVER, TUNE AND COMPARISON CONTEXT" FontWeight="Bold"/>
                    <TextBlock Text="Each recording keeps its own Desired Behavior and tune snapshot. Use the same conditions and driving task for before/after tests."
                               TextWrapping="Wrap" Margin="0,6" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <layout:AdaptivePanel MinItemWidth="250" MaxColumns="2" Spacing="10">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource FieldLabelBrush}" Text="Driver profile (choose or type a name)"/>
                            <ComboBox x:Name="DriverBox" IsEditable="True" DisplayMemberPath="Name" Text="Local driver" AutomationProperties.Name="Driver profile"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource FieldLabelBrush}" Text="Tune version name"/>
                            <TextBox x:Name="TuneLabelBox" Text="Baseline" MaxLength="160" AutomationProperties.Name="Tune version name"/>
                        </StackPanel>
                    </layout:AdaptivePanel>
                    <TextBlock Foreground="{DynamicResource FieldLabelBrush}" Text="Track layout, conditions and driving task (reuse the same description for comparable runs)" TextWrapping="Wrap" Margin="0,8,0,2"/>
                    <TextBox x:Name="ConditionsBox" MaxLength="240" AutomationProperties.Name="Conditions and driving task"/>
                    <TextBlock Foreground="{DynamicResource FieldLabelBrush}" x:Name="RunTrackText" Text="Track is captured from the active AC session when recording starts." TextWrapping="Wrap" Margin="0,5"/>
                    <WrapPanel>
                        <Button x:Name="AttachSetupButton" Content="Attach AC Setup Snapshot..." Click="AttachSetup_Click"/>
                        <Button Content="Clear Attachment" Click="ClearSetupAttachment_Click"/>
                    </WrapPanel>
                    <TextBlock Foreground="{DynamicResource FieldLabelBrush}" x:Name="SetupSnapshotText" Text="No AC setup attached. Generated ADT targets are captured; live hardware settings are not read." TextWrapping="Wrap"/>
                    <CheckBox x:Name="TuneInUseCheck" Margin="0,8">
                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" Text="I confirm I am using these generated ADT targets and the attached setup, if any, for this run." TextWrapping="Wrap"/>
                    </CheckBox>
                    <TextBlock Foreground="{DynamicResource FieldLabelBrush}" Text="Recommendation baseline (optional; leave empty for a baseline run)" TextWrapping="Wrap"/>
                    <ComboBox x:Name="RecommendationRunBox" AutomationProperties.Name="Recommendation baseline run"/>
                    <Button Content="Clear Recommendation Baseline" Click="ClearRecommendationBaseline_Click" HorizontalAlignment="Left"/>
                    <TextBlock Foreground="{DynamicResource FieldLabelBrush}" Text="Change actually tested / recommendation followed (optional)" TextWrapping="Wrap"/>
                    <TextBox x:Name="TestedChangeBox" MaxLength="1000" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="45" MaxHeight="90" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Change actually tested"/>
                </StackPanel>
            </Border>
        <layout:AdaptivePanel x:Name="TelemetryColumns"
                              MinItemWidth="360"
                              MaxColumns="2"
                              Spacing="14">

                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="LIVE TELEMETRY"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Foreground="{DynamicResource FieldLabelBrush}" x:Name="LiveText"
                                       TextWrapping="Wrap"
                                       FontFamily="Consolas"
                                       FontSize="14"
                                       Margin="0,8,0,0"
                                       Text="Not connected."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="RECORDING"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Foreground="{DynamicResource FieldLabelBrush}" x:Name="RecordingText"
                                       TextWrapping="Wrap"
                                       FontFamily="Consolas"
                                       FontSize="14"
                                       Margin="0,8,0,0"
                                       Text="No recording in progress."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="HOW DETECTION WORKS"
                                       TextWrapping="Wrap"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,8,0,0"
                                       Text="ADT calculates body slip angle from Assetto Corsa local velocity, uses local yaw rate, and detects drift while speed is at least 20 km/h and absolute body slip is at least 10°. Oscillation, extreme-angle, transition and FFB-clipping flags are heuristics: they are evidence for small corrections, not proof of a setup problem. Save representative sessions so the Tuning Assistant can compare them with Desired Behavior."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="TelemetryAnalysisPanel">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="SESSION ANALYSIS"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Foreground="{DynamicResource FieldLabelBrush}" x:Name="AnalysisText"
                                       TextWrapping="Wrap"
                                       FontFamily="Consolas"
                                       FontSize="14"
                                       Margin="0,8,0,0"
                                       Text="Record a session to analyze it."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="ASSESSMENT"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="AssessmentText"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="PROPOSED CALIBRATION DELTA"
                                       TextWrapping="Wrap"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Foreground="{DynamicResource FieldLabelBrush}" x:Name="SuggestionText"
                                       TextWrapping="Wrap"
                                       FontFamily="Consolas"
                                       FontSize="14"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="Applying this saves a correction only to ADT's calibration for the exact wheelbase + wheel + pack + car that opened this recorder. It does not directly write hardware. Generate the tune again on the Dashboard to use the new calibration, then review any AZOM changes before applying them."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
        </layout:AdaptivePanel>
        </StackPanel>
        </ScrollViewer>

        <WrapPanel Grid.Row="1"
                   x:Name="TelemetryActions"
                   Margin="0,8,0,0">
            <Button x:Name="ConnectButton"
                    Content="Connect to Assetto Corsa"
                    ToolTip="Connect ADT to Assetto Corsa shared-memory telemetry."
                    Click="Connect_Click"/>

            <Button x:Name="RecordButton"
                    Content="Start Recording"
                    ToolTip="Start a new telemetry session for the current ADT car/rig context."
                    Click="Record_Click"
                    FontWeight="Bold"
                    IsEnabled="False"/>

            <Button x:Name="StopButton"
                    Content="Stop + Analyze"
                    ToolTip="Stop the current recording and analyze the captured session."
                    Click="Stop_Click"
                    IsEnabled="False"/>

            <Button x:Name="SaveButton"
                    Content="Save Session"
                    ToolTip="Save the current analyzed telemetry session as ADT JSON and CSV."
                    Click="Save_Click"
                    IsEnabled="False"/>

            <Button x:Name="ApplyButton"
                    Content="Apply Telemetry Correction"
                    ToolTip="Save the proposed correction to ADT's calibration for this exact wheelbase + wheel + pack + car. This does not write the wheelbase directly."
                    Click="ApplySuggestion_Click"
                    IsEnabled="False"/>
        </WrapPanel>
    </Grid>
</Window>
