<Window x:Class="AtomicDriftTuner.TuningAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADT • Tuning Assistant"
        Width="1320"
        Height="900"
        MinWidth="430"
        MinHeight="430"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="AdvancedVisibility"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="AssistantTableText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="Button"
               BasedOn="{StaticResource AtomicButtonStyle}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
        </Style>

        <Style TargetType="ComboBox"
               BasedOn="{StaticResource AtomicComboBoxStyle}">
            <Setter Property="Padding" Value="7"/>
        </Style>

        <Style TargetType="Border"
               x:Key="AssistantCard">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="AssistantBodyScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock x:Name="AssistantFocusText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="TELEMETRY-ASSISTED TUNING"
                       FontSize="26"
                       FontWeight="Bold"
                       Visibility="Collapsed"/>

            <TextBlock x:Name="SetupText"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,10"/>

            <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="Driver history filter" FontWeight="Bold"/>
            <ComboBox x:Name="HistoryDriverBox" DisplayMemberPath="Name" AutomationProperties.Name="Driver history filter"
                      SelectionChanged="HistoryDriver_SelectionChanged" Margin="0,4,0,10"/>
            <Border Style="{StaticResource AssistantCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="Saved session"
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>

                    <ComboBox Grid.Row="1"
                              x:Name="SessionBox"
                              AutomationProperties.Name="Saved telemetry session"
                              SelectionChanged="SessionBox_SelectionChanged"
                              Margin="0,4,8,4"/>

                    <Button Grid.Row="1"
                            Grid.Column="1"
                            x:Name="RefreshSessionsButton"
                            Content="Refresh Sessions"
                            ToolTip="Reload recent telemetry sessions matching this exact ADT hardware/car context."
                            Click="RefreshSessions_Click"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource AssistantCard}" Visibility="{Binding IsChecked, ElementName=AdvancedTelemetryToggle, Converter={StaticResource AdvancedVisibility}}">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="DESIRED BEHAVIOR TARGET"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="DesiredBehaviorText"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <CheckBox x:Name="AdvancedTelemetryToggle" Content="Show advanced telemetry and recommendations" IsChecked="False" Checked="AdvancedTelemetry_Changed" Unchecked="AdvancedTelemetry_Changed" Margin="0,4,0,10"/>
        <TabControl x:Name="AssistantTabs" SelectedIndex="0">
            <TabItem Header="Your next step">
                <StackPanel Margin="12">
                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="Goal saved with this run" FontWeight="Bold"/>
                    <TextBlock x:Name="NextGoalText" Foreground="{DynamicResource FieldLabelBrush}" Text="Select a saved run." TextWrapping="Wrap" Margin="0,4,0,14"/>
                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="What ADT noticed" FontWeight="Bold" FontSize="18"/>
                    <TextBlock x:Name="NextNoticedText" Foreground="{DynamicResource FieldLabelBrush}" Text="Record and save a run to get a next step." TextWrapping="Wrap" FontSize="15" Margin="0,6,0,8"/>
                    <TextBlock x:Name="NextConfidenceText" Foreground="{DynamicResource SecondaryTextBrush}" Text="Waiting for a run" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="Try this next" FontWeight="Bold" FontSize="18"/>
                    <TextBlock x:Name="NextInstructionText" Foreground="{DynamicResource FieldLabelBrush}" Text="Use the dashboard walkthrough to prepare your recording." TextWrapping="Wrap" FontSize="15" Margin="0,6,0,12"/>
                    <Expander x:Name="NextWhyExpander" Header="Why this next step?" IsExpanded="False" HorizontalContentAlignment="Stretch">
                        <StackPanel Margin="8">
                            <TextBlock x:Name="NextWhyText" Foreground="{DynamicResource FieldLabelBrush}" TextWrapping="Wrap"/>
                            <Button x:Name="ShowEvidenceButton" Content="View supporting events" Click="ShowEvidence_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Expander>
                    <Border x:Name="CarTestCard" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,16,0,4">
                        <StackPanel>
                            <TextBlock Text="Your next car setup change" Foreground="{DynamicResource SectionHeadingBrush}" FontWeight="Bold" FontSize="17" TextWrapping="Wrap"/>
                            <TextBlock x:Name="CarTestSummaryText" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,8,0,8"/>
                            <Button x:Name="ReviewCarTestButton" Content="Review one car setup change" Click="ReviewCarTest_Click" HorizontalAlignment="Left" Style="{StaticResource AtomicButtonStyle}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="Gearing &amp; ECU" FontWeight="Bold" Margin="0,16,0,4"/>
                    <TextBlock x:Name="PowertrainQuickText" Foreground="{DynamicResource FieldLabelBrush}" Text="Select a run to review RPM and recorded setup evidence." TextWrapping="Wrap"/>
                    <Button Content="Review gearing &amp; ECU" Click="ShowPowertrain_Click" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                </StackPanel>
            </TabItem>
            <TabItem x:Name="PowertrainTab" Header="Gearing &amp; ECU">
                <StackPanel Margin="12">
                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="What the run shows" FontWeight="Bold" FontSize="18"/>
                    <TextBlock x:Name="PowertrainSummaryText" Foreground="{DynamicResource FieldLabelBrush}" Text="Select a saved run." TextWrapping="Wrap" Margin="0,6,0,8"/>
                    <TextBlock x:Name="PowertrainTargetText" Foreground="{DynamicResource FieldLabelBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="Next gearing test" FontWeight="Bold"/>
                    <TextBlock x:Name="PowertrainNextTestText" Foreground="{DynamicResource FieldLabelBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="ECU selection recorded with this run" FontWeight="Bold"/>
                    <TextBlock x:Name="PowertrainEcuText" Foreground="{DynamicResource FieldLabelBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="To test ECU: keep gearing fixed, choose one different ECU setting in the pits, confirm the new setup, then record the same section again. Compare RPM, speed retained and control; a map name alone does not show whether it is better." TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="Use AC Setup → Gearing to calculate and save a separate test setup. Load or explicitly apply it in the pits before recording again. This review does not change the tune." TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Expander x:Name="PowertrainMeasurementsExpander" Header="RPM by gear, driving phase and input events" HorizontalContentAlignment="Stretch">
                        <StackPanel Margin="8">
                            <TextBlock Foreground="{DynamicResource FieldLabelBrush}" Text="Typical RPM and speed: time-weighted 10th–90th percentiles. Near limiter means near the recorded base definition; actual limiter contact is unverified." TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <DataGrid x:Name="PowertrainGearGrid" AutomationProperties.Name="Recorded gearing evidence" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinColumnWidth="80" MinHeight="140" MaxHeight="300" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Gear" Binding="{Binding Gear}" Width="65"/>
                                    <DataGridTextColumn Header="Drift (s)" Binding="{Binding Seconds, StringFormat=F1}" Width="95"/>
                                    <DataGridTextColumn Header="Typical RPM" Binding="{Binding RpmBand}" Width="130"/>
                                    <DataGridTextColumn Header="Median RPM" Binding="{Binding MedianRpm, StringFormat=F0}" Width="115"/>
                                    <DataGridTextColumn Header="Typical km/h" Binding="{Binding SpeedBand}" Width="130"/>
                                    <DataGridTextColumn Header="High throttle (s)" Binding="{Binding HighThrottleSeconds, StringFormat=F1}" Width="135"/>
                                    <DataGridTextColumn Header="Chosen RPM band" Binding="{Binding TargetExposure}" ElementStyle="{StaticResource AssistantTableText}" Width="230"/>
                                    <DataGridTextColumn Header="Near base limiter" Binding="{Binding LimiterExposure}" Width="150"/>
                                    <DataGridTextColumn Header="Recorded gear ratio" Binding="{Binding RecordedRatio, StringFormat=F3, TargetNullValue=Unknown}" Width="160"/>
                                    <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="Where the RPM occurs" FontWeight="Bold" Margin="0,12,0,6"/>
                            <DataGrid x:Name="PowertrainPhaseGrid" AutomationProperties.Name="RPM by drift phase" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinColumnWidth="80" MinHeight="130" MaxHeight="260" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Gear" Binding="{Binding Gear}" Width="65"/>
                                    <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="235"/>
                                    <DataGridTextColumn Header="Seconds" Binding="{Binding Seconds, StringFormat=F1}" Width="100"/>
                                    <DataGridTextColumn Header="Median RPM" Binding="{Binding MedianRpm, StringFormat=F0}" Width="120"/>
                                    <DataGridTextColumn Header="Typical RPM" Binding="{Binding RpmBand}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="Repeated periods — select for full input context" FontWeight="Bold" TextWrapping="Wrap" Margin="0,12,0,6"/>
                            <DataGrid x:Name="PowertrainEventGrid" AutomationProperties.Name="Gearing input events" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinColumnWidth="80" MinHeight="130" MaxHeight="280" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Observation" Binding="{Binding Kind}" Width="230"/>
                                    <DataGridTextColumn Header="Gear" Binding="{Binding Gear}" Width="65"/>
                                    <DataGridTextColumn Header="Start (s)" Binding="{Binding StartSeconds, StringFormat=F1}" Width="100"/>
                                    <DataGridTextColumn Header="Duration (s)" Binding="{Binding DurationSeconds, StringFormat=F1}" Width="110"/>
                                    <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="235"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="PowertrainEventDetailText" Foreground="{DynamicResource FieldLabelBrush}" Text="{Binding SelectedItem.Evidence, ElementName=PowertrainEventGrid, TargetNullValue='Select an event to inspect throttle, brake, clutch and RPM context.'}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="PowertrainSourceExpander" Header="Recorded definitions, ECU curve and limitations" HorizontalContentAlignment="Stretch" Margin="0,10,0,0">
                        <StackPanel Margin="8">
                            <TextBlock x:Name="PowertrainSetupText" Foreground="{DynamicResource FieldLabelBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Foreground="{DynamicResource FieldLabelBrush}" Text="Selected ECU curve: configured torque multiplier, not measured horsepower. Points are retained with new run snapshots." TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <DataGrid x:Name="PowertrainMapGrid" AutomationProperties.Name="Recorded ECU curve points" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="120" MaxHeight="230" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="RPM" Binding="{Binding Rpm, StringFormat=F0}" Width="130"/>
                                    <DataGridTextColumn Header="Configured multiplier" Binding="{Binding Multiplier, StringFormat=F3}" Width="210"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="PowertrainLimitationsText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="PowertrainComparisonExpander" Header="Compare gearing and ECU evidence with the selected baseline" HorizontalContentAlignment="Stretch" Margin="0,10,0,0">
                        <StackPanel Margin="8">
                            <Button x:Name="PowertrainBaselineButton" Content="Choose baseline in Before / After" HorizontalAlignment="Left" Click="PowertrainBaseline_Click" Margin="0,0,0,8"/>
                            <TextBlock x:Name="PowertrainComparisonText" Foreground="{DynamicResource FieldLabelBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <DataGrid x:Name="PowertrainComparisonGrid" AutomationProperties.Name="Gearing and ECU run differences" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinColumnWidth="100" MinHeight="140" MaxHeight="320" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Observation" Binding="{Binding Metric}" Width="200"/>
                                    <DataGridTextColumn Header="Baseline" Binding="{Binding Previous}" ElementStyle="{StaticResource AssistantTableText}" Width="230"/>
                                    <DataGridTextColumn Header="Selected run" Binding="{Binding Current}" ElementStyle="{StaticResource AssistantTableText}" Width="230"/>
                                    <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="130"/>
                                    <DataGridTextColumn Header="Meaning" Binding="{Binding Interpretation}" ElementStyle="{StaticResource AssistantTableText}" Width="360"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </TabItem>
            <TabItem Header="Assessment" Visibility="{Binding IsChecked, ElementName=AdvancedTelemetryToggle, Converter={StaticResource AdvancedVisibility}}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource AssistantCard}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="ADT ASSESSMENT"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Foreground="{DynamicResource FieldLabelBrush}" x:Name="OverallText"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>

                            <TextBlock x:Name="ConfidenceText"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1"
                              x:Name="AssessmentGrid"
                              MinHeight="180"
                              MaxHeight="420"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Behavior" Binding="{Binding Behavior, Mode=OneWay}" Width="150"/>
                            <DataGridTextColumn Header="Desired" Binding="{Binding Desired, Mode=OneWay}" Width="150"/>
                            <DataGridTextColumn Header="Observed" Binding="{Binding Observed, Mode=OneWay}" Width="220"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, Mode=OneWay}" Width="105"/>
                            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence, Mode=OneWay}" ElementStyle="{StaticResource AssistantTableText}" MinWidth="280" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Recommendations" Visibility="{Binding IsChecked, ElementName=AdvancedTelemetryToggle, Converter={StaticResource AdvancedVisibility}}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource AssistantCard}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="TEMPORARY AC SETUP GUIDANCE"
                                       TextWrapping="Wrap"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="BehaviorGuidanceText"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1"
                              x:Name="RecommendationGrid"
                              MinHeight="180"
                              MaxHeight="420"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Domain" Binding="{Binding Domain, Mode=OneWay}" Width="140"/>
                            <DataGridTextColumn Header="Priority" Binding="{Binding Priority, Mode=OneWay}" Width="90"/>
                            <DataGridTextColumn Header="Recommended Change" Binding="{Binding Change, Mode=OneWay}" ElementStyle="{StaticResource AssistantTableText}" Width="320"/>
                            <DataGridTextColumn Header="Why" Binding="{Binding Why, Mode=OneWay}" ElementStyle="{StaticResource AssistantTableText}" MinWidth="280" Width="*"/>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, Mode=OneWay}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2"
                            Style="{StaticResource AssistantCard}"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource FieldLabelBrush}" Text="Select one recommendation above, then create a test plan. ADT will remember your driver, baseline, conditions and selected change for the recorder." TextWrapping="Wrap" Margin="0,6"/>
                            <Button x:Name="TestRecommendationButton" Content="Test This Recommendation" Click="TestRecommendation_Click" HorizontalAlignment="Left"/>
                            <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="WHAT HAPPENS NEXT"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Apply Calibration saves bounded telemetry deltas into ADT's calibration profile only; it does not directly write AZOM. Open AC Setup with Guidance passes temporary Desired Behavior values into the existing range-safe car setup tuner; it does not save a behavior profile or setup file automatically."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Phase Evidence" Visibility="{Binding IsChecked, ElementName=AdvancedTelemetryToggle, Converter={StaticResource AdvancedVisibility}}">
                <StackPanel Margin="12">
                    <TextBlock Foreground="{DynamicResource FieldLabelBrush}" x:Name="QualityText" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <DataGrid x:Name="PhaseGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="180" MaxHeight="420"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="180"/>
                            <DataGridTextColumn Header="Start (s)" Binding="{Binding StartSeconds, StringFormat=F2}" Width="100"/>
                            <DataGridTextColumn Header="Duration (s)" Binding="{Binding DurationSeconds, StringFormat=F2}" Width="110"/>
                            <DataGridTextColumn Header="Speed (km/h)" Binding="{Binding SpeedKmh, StringFormat=F1}" Width="120"/>
                            <DataGridTextColumn Header="Evidence / limitations" Binding="{Binding Evidence}" ElementStyle="{StaticResource AssistantTableText}" MinWidth="280" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>
            <TabItem Header="Pedal Evidence" Visibility="{Binding IsChecked, ElementName=AdvancedTelemetryToggle, Converter={StaticResource AdvancedVisibility}}">
                <StackPanel Margin="12">
                    <TextBlock x:Name="PedalSectionHeading" Foreground="{DynamicResource SectionHeadingBrush}" Text="How your inputs relate to the car's response" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Foreground="{DynamicResource FieldLabelBrush}" Text="1. Record and save a run. 2. Inspect the events below. 3. Repeat similar pedal inputs when testing one setup change, then open Before / After." TextWrapping="Wrap" Margin="0,6,0,8"/>
                    <TextBlock x:Name="PedalSummaryText" Foreground="{DynamicResource FieldLabelBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <DataGrid x:Name="PedalGrid" AutomationProperties.Name="Pedal input and response evidence" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow" MinColumnWidth="80"
                              MinHeight="180" MaxHeight="360" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Event" Binding="{Binding Kind}" ElementStyle="{StaticResource AssistantTableText}" MinWidth="160" Width="180"/>
                            <DataGridTextColumn Header="Start (s)" Binding="{Binding StartSeconds, StringFormat=F2}" Width="90"/>
                            <DataGridTextColumn Header="Duration (s)" Binding="{Binding DurationSeconds, StringFormat=F2}" Width="105"/>
                            <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" MinWidth="120" Width="130"/>
                            <DataGridTextColumn Header="Input" Binding="{Binding Input}" ElementStyle="{StaticResource AssistantTableText}" MinWidth="220" Width="240"/>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="100"/>
                            <DataGridTextColumn Header="Response preview — select for full details" Binding="{Binding Evidence}" MinWidth="340" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource AssistantTableText}">
                                        <Setter Property="TextWrapping" Value="NoWrap"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="PedalDetailHeading" Foreground="{DynamicResource SectionHeadingBrush}" Text="Selected event — full explanation" FontWeight="Bold" TextWrapping="Wrap" Margin="0,12,0,6"/>
                    <TextBlock x:Name="PedalSelectedInputText" Foreground="{DynamicResource FieldLabelBrush}" Text="{Binding SelectedItem.Input, ElementName=PedalGrid}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock x:Name="PedalSelectedEvidenceText" Foreground="{DynamicResource FieldLabelBrush}" Text="{Binding SelectedItem.Evidence, ElementName=PedalGrid, TargetNullValue='Select an event above to read its complete explanation here.'}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PedalContextHeading" Foreground="{DynamicResource SectionHeadingBrush}" Text="Pedal use during clean drift" FontWeight="Bold" Margin="0,12,0,6"/>
                    <DataGrid x:Name="PedalContextGrid" AutomationProperties.Name="Pedal exposure context" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              MinColumnWidth="100" MinHeight="140" MaxHeight="300" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Input measure" Binding="{Binding Name}" MinWidth="200" Width="210"/>
                            <DataGridTextColumn Header="Observed" Binding="{Binding DisplayValue}" Width="120"/>
                            <DataGridTextColumn Header="Meaning" Binding="{Binding Evidence}" ElementStyle="{StaticResource AssistantTableText}" MinWidth="300" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="PedalLimitationsText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Before / After">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="Baseline run (choose an earlier run by this driver)" TextWrapping="Wrap" FontWeight="Bold"/>
                    <ComboBox x:Name="BaselineSessionBox" AutomationProperties.Name="Baseline run" SelectionChanged="BaselineSession_SelectionChanged" Margin="0,4,0,8"/>
                    <TextBlock x:Name="ComparisonSimpleText" Foreground="{DynamicResource FieldLabelBrush}" Text="Choose an earlier baseline to check whether the result changed." TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Expander x:Name="ComparisonReasonsExpander" Header="Comparison conditions and limitations" IsExpanded="False" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
                    <TextBlock x:Name="ComparisonHeaderText"
                               Text="Choose an earlier baseline. ADT checks the recorded driver, track, conditions, tune and Desired Behavior."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    </Expander>
                    </StackPanel>

                    <Expander Grid.Row="1" x:Name="ComparisonDetailsExpander" Header="View detailed measurements" IsExpanded="False" HorizontalContentAlignment="Stretch">
                    <DataGrid
                              x:Name="ComparisonGrid"
                              MinHeight="180"
                              MaxHeight="420"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Metric" Binding="{Binding Metric, Mode=OneWay}" Width="170"/>
                            <DataGridTextColumn Header="Previous" Binding="{Binding Previous, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="Current" Binding="{Binding Current, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="Change" Binding="{Binding Change, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="Interpretation" Binding="{Binding Interpretation, Mode=OneWay}" ElementStyle="{StaticResource AssistantTableText}" MinWidth="280" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Expander>
                </Grid>
            </TabItem>
            <TabItem Header="Tune &amp; Run History">
                <StackPanel Margin="12">
                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="Tune snapshots for this driver and car" FontWeight="Bold"/>
                    <ComboBox x:Name="TuneHistoryBox" DisplayMemberPath="DisplayName" SelectionChanged="TuneHistory_SelectionChanged" AutomationProperties.Name="Tune version history" Margin="0,4,0,8"/>
                    <TextBlock Foreground="{DynamicResource FieldLabelBrush}" x:Name="TuneHistoryText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Button Content="Show Compared Tune Changes" Click="ShowComparedTunes_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <DataGrid x:Name="TuneChangesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="120" MaxHeight="280"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Setting" Binding="{Binding Metric}" Width="260"/>
                            <DataGridTextColumn Header="Baseline / value" Binding="{Binding Previous}" Width="140"/>
                            <DataGridTextColumn Header="After" Binding="{Binding Current}" Width="110"/>
                            <DataGridTextColumn Header="Meaning" Binding="{Binding Interpretation}" ElementStyle="{StaticResource AssistantTableText}" MinWidth="240" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Foreground="{DynamicResource SectionHeadingBrush}" Text="Driver feedback for the selected run" FontWeight="Bold" Margin="0,12,0,4"/>
                    <ComboBox x:Name="DriverRatingBox" AutomationProperties.Name="Driver outcome rating"/>
                    <TextBlock Text="What will you do next? This records your decision; it does not apply or undo settings." Foreground="{DynamicResource FieldLabelBrush}" TextWrapping="Wrap" Margin="0,8,0,4"/>
                    <ComboBox x:Name="NextActionBox" AutomationProperties.Name="Next action after comparison"/>
                    <TextBlock Text="Keep: save your preferred settings and verify again. Revert: load your original AC setup and/or manually restore the earlier FFB values from Tune &amp; Run History. Test again: return to the dashboard and choose Record Comparison Run Again." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <TextBox x:Name="DriverNotesBox" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="4000" MinHeight="60" MaxHeight="120"
                             VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Driver feedback notes" Margin="0,6"/>
                    <Button x:Name="SaveReviewButton" Content="Save Run Review" Click="SaveRunReview_Click" HorizontalAlignment="Left"/>
                    <TextBlock Foreground="{DynamicResource FieldLabelBrush}" Text="Saved reviews (append-only; choose one to read)" TextWrapping="Wrap" Margin="0,8,0,4"/>
                    <ComboBox x:Name="ReviewHistoryBox" DisplayMemberPath="DisplayName" SelectionChanged="ReviewHistory_SelectionChanged" AutomationProperties.Name="Saved run reviews"/>
                    <TextBlock Foreground="{DynamicResource FieldLabelBrush}" x:Name="ReviewHistoryText" TextWrapping="Wrap" Margin="0,6"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Margin="0,8,0,0">

            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0"/>

            <Button x:Name="NextActionButton" Content="Back to dashboard" Click="NextAction_Click" HorizontalAlignment="Left" FontWeight="Bold"/>
            <WrapPanel x:Name="AssistantActions" Visibility="{Binding IsChecked, ElementName=AdvancedTelemetryToggle, Converter={StaticResource AdvancedVisibility}}">
                <Button x:Name="ApplyCalibrationButton"
                        Content="Apply Calibration Recommendation"
                        ToolTip="Save the current report's bounded telemetry correction to ADT calibration for this exact hardware/car context."
                        Click="ApplyCalibration_Click"
                        IsEnabled="False"/>

                <Button x:Name="OpenSetupButton"
                        Content="Open AC Setup with Guidance"
                        ToolTip="Open the range-safe AC setup tuner with this report's temporary Desired Behavior guidance."
                        Click="OpenSetupWithGuidance_Click"
                        IsEnabled="False"
                        FontWeight="Bold"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
