<Window x:Class="AtomicDriftTuner.TuningAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADT • Tuning Assistant"
        Width="1320"
        Height="900"
        MinWidth="430"
        MinHeight="430"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="AssistantTableText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="Button"
               BasedOn="{StaticResource AtomicButtonStyle}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <Style TargetType="ComboBox"
               BasedOn="{StaticResource AtomicComboBoxStyle}">
            <Setter Property="Padding" Value="7"/>
        </Style>

        <Style TargetType="Border"
               x:Key="AssistantCard">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="AssistantBodyScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="TELEMETRY-ASSISTED TUNING"
                       FontSize="26"
                       FontWeight="Bold"
                       Visibility="Collapsed"/>

            <TextBlock x:Name="SetupText"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,10"/>

            <TextBlock Text="Driver history filter" FontWeight="Bold"/>
            <ComboBox x:Name="HistoryDriverBox" DisplayMemberPath="Name" AutomationProperties.Name="Driver history filter"
                      SelectionChanged="HistoryDriver_SelectionChanged" Margin="0,4,0,10"/>
            <Border Style="{StaticResource AssistantCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Saved session"
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>

                    <ComboBox Grid.Row="1"
                              x:Name="SessionBox"
                              AutomationProperties.Name="Saved telemetry session"
                              SelectionChanged="SessionBox_SelectionChanged"
                              Margin="0,4,8,4"/>

                    <Button Grid.Row="1"
                            Grid.Column="1"
                            x:Name="RefreshSessionsButton"
                            Content="Refresh Sessions"
                            ToolTip="Reload recent telemetry sessions matching this exact ADT hardware/car context."
                            Click="RefreshSessions_Click"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource AssistantCard}">
                <StackPanel>
                    <TextBlock Text="DESIRED BEHAVIOR TARGET"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="DesiredBehaviorText"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        <TabControl x:Name="AssistantTabs">
            <TabItem Header="Assessment">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource AssistantCard}">
                        <StackPanel>
                            <TextBlock Text="ADT ASSESSMENT"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="OverallText"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>

                            <TextBlock x:Name="ConfidenceText"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1"
                              x:Name="AssessmentGrid"
                              MinHeight="180"
                              MaxHeight="420"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Behavior" Binding="{Binding Behavior, Mode=OneWay}" Width="150"/>
                            <DataGridTextColumn Header="Desired" Binding="{Binding Desired, Mode=OneWay}" Width="150"/>
                            <DataGridTextColumn Header="Observed" Binding="{Binding Observed, Mode=OneWay}" Width="220"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, Mode=OneWay}" Width="105"/>
                            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence, Mode=OneWay}" ElementStyle="{StaticResource AssistantTableText}" MinWidth="280" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Recommendations">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource AssistantCard}">
                        <StackPanel>
                            <TextBlock Text="TEMPORARY AC SETUP GUIDANCE"
                                       TextWrapping="Wrap"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="BehaviorGuidanceText"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1"
                              x:Name="RecommendationGrid"
                              MinHeight="180"
                              MaxHeight="420"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Domain" Binding="{Binding Domain, Mode=OneWay}" Width="140"/>
                            <DataGridTextColumn Header="Priority" Binding="{Binding Priority, Mode=OneWay}" Width="90"/>
                            <DataGridTextColumn Header="Recommended Change" Binding="{Binding Change, Mode=OneWay}" ElementStyle="{StaticResource AssistantTableText}" Width="320"/>
                            <DataGridTextColumn Header="Why" Binding="{Binding Why, Mode=OneWay}" ElementStyle="{StaticResource AssistantTableText}" MinWidth="280" Width="*"/>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, Mode=OneWay}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2"
                            Style="{StaticResource AssistantCard}"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Select one recommendation above, then create a test plan. ADT will remember your driver, baseline, conditions and selected change for the recorder." TextWrapping="Wrap" Margin="0,6"/>
                            <Button x:Name="TestRecommendationButton" Content="Test This Recommendation" Click="TestRecommendation_Click" HorizontalAlignment="Left"/>
                            <TextBlock Text="WHAT HAPPENS NEXT"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Apply Calibration saves bounded telemetry deltas into ADT's calibration profile only; it does not directly write AZOM. Open AC Setup with Guidance passes temporary Desired Behavior values into the existing range-safe car setup tuner; it does not save a behavior profile or setup file automatically."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Phase Evidence">
                <StackPanel Margin="12">
                    <TextBlock x:Name="QualityText" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <DataGrid x:Name="PhaseGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="180" MaxHeight="420"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="180"/>
                            <DataGridTextColumn Header="Start (s)" Binding="{Binding StartSeconds, StringFormat=F2}" Width="100"/>
                            <DataGridTextColumn Header="Duration (s)" Binding="{Binding DurationSeconds, StringFormat=F2}" Width="110"/>
                            <DataGridTextColumn Header="Speed (km/h)" Binding="{Binding SpeedKmh, StringFormat=F1}" Width="120"/>
                            <DataGridTextColumn Header="Evidence / limitations" Binding="{Binding Evidence}" ElementStyle="{StaticResource AssistantTableText}" MinWidth="280" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>
            <TabItem Header="Before / After">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                    <TextBlock Text="Baseline run (choose an earlier run by this driver)" TextWrapping="Wrap" FontWeight="Bold"/>
                    <ComboBox x:Name="BaselineSessionBox" AutomationProperties.Name="Baseline run" SelectionChanged="BaselineSession_SelectionChanged" Margin="0,4,0,8"/>
                    <TextBlock x:Name="ComparisonHeaderText"
                               Text="Choose an earlier baseline. ADT checks the recorded driver, track, conditions, tune and Desired Behavior."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              x:Name="ComparisonGrid"
                              MinHeight="180"
                              MaxHeight="420"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Metric" Binding="{Binding Metric, Mode=OneWay}" Width="170"/>
                            <DataGridTextColumn Header="Previous" Binding="{Binding Previous, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="Current" Binding="{Binding Current, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="Change" Binding="{Binding Change, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="Interpretation" Binding="{Binding Interpretation, Mode=OneWay}" ElementStyle="{StaticResource AssistantTableText}" MinWidth="280" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Tune &amp; Run History">
                <StackPanel Margin="12">
                    <TextBlock Text="Tune snapshots for this driver and car" FontWeight="Bold"/>
                    <ComboBox x:Name="TuneHistoryBox" DisplayMemberPath="DisplayName" SelectionChanged="TuneHistory_SelectionChanged" AutomationProperties.Name="Tune version history" Margin="0,4,0,8"/>
                    <TextBlock x:Name="TuneHistoryText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Button Content="Show Compared Tune Changes" Click="ShowComparedTunes_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <DataGrid x:Name="TuneChangesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="120" MaxHeight="280"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Setting" Binding="{Binding Metric}" Width="260"/>
                            <DataGridTextColumn Header="Baseline / value" Binding="{Binding Previous}" Width="140"/>
                            <DataGridTextColumn Header="After" Binding="{Binding Current}" Width="110"/>
                            <DataGridTextColumn Header="Meaning" Binding="{Binding Interpretation}" ElementStyle="{StaticResource AssistantTableText}" MinWidth="240" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Driver feedback for the selected run" FontWeight="Bold" Margin="0,12,0,4"/>
                    <ComboBox x:Name="DriverRatingBox" AutomationProperties.Name="Driver outcome rating"/>
                    <TextBox x:Name="DriverNotesBox" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="4000" MinHeight="60" MaxHeight="120"
                             VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Driver feedback notes" Margin="0,6"/>
                    <Button x:Name="SaveReviewButton" Content="Save Run Review" Click="SaveRunReview_Click" HorizontalAlignment="Left"/>
                    <TextBlock Text="Saved reviews (append-only; choose one to read)" TextWrapping="Wrap" Margin="0,8,0,4"/>
                    <ComboBox x:Name="ReviewHistoryBox" DisplayMemberPath="DisplayName" SelectionChanged="ReviewHistory_SelectionChanged" AutomationProperties.Name="Saved run reviews"/>
                    <TextBlock x:Name="ReviewHistoryText" TextWrapping="Wrap" Margin="0,6"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Margin="0,8,0,0">

            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0"/>

            <WrapPanel x:Name="AssistantActions">
                <Button x:Name="ApplyCalibrationButton"
                        Content="Apply Calibration Recommendation"
                        ToolTip="Save the current report's bounded telemetry correction to ADT calibration for this exact hardware/car context."
                        Click="ApplyCalibration_Click"
                        IsEnabled="False"/>

                <Button x:Name="OpenSetupButton"
                        Content="Open AC Setup with Guidance"
                        ToolTip="Open the range-safe AC setup tuner with this report's temporary Desired Behavior guidance."
                        Click="OpenSetupWithGuidance_Click"
                        IsEnabled="False"
                        FontWeight="Bold"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
