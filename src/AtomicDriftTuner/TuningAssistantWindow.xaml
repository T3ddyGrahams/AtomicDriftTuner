<Window x:Class="AtomicDriftTuner.TuningAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atomic Drift Tuner v0.7.3 BETA 2 - Tuning Assistant"
        Width="1320" Height="900"
        MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource AtomicComboBoxStyle}">
            <Setter Property="Padding" Value="7"/>
        </Style>
        <Style TargetType="Border" x:Key="AssistantCard">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="TELEMETRY-ASSISTED TUNING"
                       FontSize="26"
                       FontWeight="Bold"/>
            <TextBlock x:Name="SetupText"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,10"/>

            <Border Style="{StaticResource AssistantCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Saved session"
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>
                    <ComboBox Grid.Column="1"
                              x:Name="SessionBox"
                              SelectionChanged="SessionBox_SelectionChanged"
                              Margin="8,0"/>
                    <Button Grid.Column="2"
                            Content="Refresh Sessions"
                            Click="RefreshSessions_Click"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource AssistantCard}">
                <StackPanel>
                    <TextBlock Text="DESIRED BEHAVIOR TARGET"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="DesiredBehaviorText"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <TabControl Grid.Row="1"
                    x:Name="AssistantTabs">
            <TabItem Header="Assessment">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource AssistantCard}">
                        <StackPanel>
                            <TextBlock Text="ATOMIC ASSESSMENT"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="OverallText"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                            <TextBlock x:Name="ConfidenceText"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1"
                              x:Name="AssessmentGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Behavior" Binding="{Binding Behavior, Mode=OneWay}" Width="150"/>
                            <DataGridTextColumn Header="Desired" Binding="{Binding Desired, Mode=OneWay}" Width="150"/>
                            <DataGridTextColumn Header="Observed" Binding="{Binding Observed, Mode=OneWay}" Width="220"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, Mode=OneWay}" Width="105"/>
                            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence, Mode=OneWay}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Recommendations">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource AssistantCard}">
                        <StackPanel>
                            <TextBlock Text="TEMPORARY AC SETUP GUIDANCE"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="BehaviorGuidanceText"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1"
                              x:Name="RecommendationGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Domain" Binding="{Binding Domain, Mode=OneWay}" Width="140"/>
                            <DataGridTextColumn Header="Priority" Binding="{Binding Priority, Mode=OneWay}" Width="90"/>
                            <DataGridTextColumn Header="Recommended Change" Binding="{Binding Change, Mode=OneWay}" Width="320"/>
                            <DataGridTextColumn Header="Why" Binding="{Binding Why, Mode=OneWay}" Width="*"/>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, Mode=OneWay}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2"
                            Style="{StaticResource AssistantCard}"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="SAFETY / CONTROL"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Apply Calibration saves bounded telemetry deltas into Atomic's calibration profile only; it does not directly write AZOM. Open AC Setup with Guidance passes temporary Desired Behavior values into the existing range-safe car setup tuner; it does not save a behavior profile or setup file automatically."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Before / After">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ComparisonHeaderText"
                               Text="Atomic compares the selected session with the previous saved session for this exact wheelbase + wheel + pack + car when one exists."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="1"
                              x:Name="ComparisonGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Metric" Binding="{Binding Metric, Mode=OneWay}" Width="170"/>
                            <DataGridTextColumn Header="Previous" Binding="{Binding Previous, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="Current" Binding="{Binding Current, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="Change" Binding="{Binding Change, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="Interpretation" Binding="{Binding Interpretation, Mode=OneWay}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0"/>
            <WrapPanel Grid.Column="1">
                <Button x:Name="ApplyCalibrationButton"
                        Content="Apply Calibration Recommendation"
                        Click="ApplyCalibration_Click"
                        IsEnabled="False"/>
                <Button x:Name="OpenSetupButton"
                        Content="Open AC Setup with Guidance"
                        Click="OpenSetupWithGuidance_Click"
                        IsEnabled="False"
                        FontWeight="Bold"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
