<Window x:Class="AtomicDriftTuner.UpdatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADT • Updates"
        Width="860"
        Height="760"
        MinWidth="430"
        MinHeight="430"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="Button"
               BasedOn="{StaticResource AtomicButtonStyle}">
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <Style TargetType="Border"
               x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="UpdatesBodyScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="UPDATES"
                       FontSize="25"
                       FontWeight="Bold"
                       Visibility="Collapsed"/>

            <TextBlock x:Name="CurrentVersionText"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,5"/>

            <TextBlock Text="ADT checks the official T3ddyGrahams/AtomicDriftTuner GitHub Releases feed only when you press Check for Updates. This window never auto-launches a downloaded installer."
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="UPDATE CHANNEL"
                                   FontWeight="Bold"/>

                        <CheckBox x:Name="IncludePrereleaseBox"
                                  HorizontalContentAlignment="Stretch"
                                  IsChecked="True"
                                  Margin="0,8,0,10">
                            <TextBlock Text="Include public beta / pre-release versions"
                                       TextWrapping="Wrap"/>
                        </CheckBox>

                        <WrapPanel>
                            <Button x:Name="CheckButton"
                                    Content="CHECK FOR UPDATES"
                                    Click="Check_Click"
                                    FontWeight="Bold"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="{DynamicResource AccentTextBrush}"/>

                            <Button x:Name="OpenReleasesButton"
                                    Content="OPEN OFFICIAL GITHUB RELEASES"
                                    Click="OpenReleases_Click"/>
                        </WrapPanel>

                        <TextBlock x:Name="CheckStatusText"
                                   Text="No update check has been run yet."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="LATEST MATCHING RELEASE"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="ReleaseTitleText"
                                   Text="—"
                                   TextWrapping="Wrap"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>

                        <TextBlock x:Name="ReleaseMetaText"
                                   Text="Check GitHub to load release details."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,2,0,8"
                                   TextWrapping="Wrap"/>

                        <TextBox x:Name="ReleaseNotesBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="130"
                                 MaxHeight="220"
                                 Padding="9"
                                 Background="{DynamicResource InputBrush}"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 AutomationProperties.Name="GitHub release notes"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="DOWNLOAD"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Choose the destination yourself. ADT shows a local SHA-256 after a successful download and does not auto-launch the file. A local hash identifies the downloaded bytes; by itself it is not proof of authenticity unless it is compared with a trusted published value."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,12"/>

                        <StackPanel Margin="0,0,0,9">
                            <StackPanel>
                                <TextBlock x:Name="InstallerNameText"
                                           Text="Installer: not loaded"
                                           TextWrapping="Wrap"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="InstallerSizeText"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>

                            <Button x:Name="DownloadInstallerButton"
                                    HorizontalAlignment="Left"
                                    Content="DOWNLOAD INSTALLER"
                                    Click="DownloadInstaller_Click"
                                    IsEnabled="False"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="PortableNameText"
                                           Text="Portable ZIP: not loaded"
                                           TextWrapping="Wrap"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="PortableSizeText"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>

                            <Button x:Name="DownloadPortableButton"
                                    HorizontalAlignment="Left"
                                    Content="DOWNLOAD PORTABLE ZIP"
                                    Click="DownloadPortable_Click"
                                    IsEnabled="False"/>
                        </StackPanel>

                        <ProgressBar x:Name="DownloadProgress"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="16"
                                     Value="0"/>

                        <TextBlock x:Name="DownloadStatusText"
                                   Text="No download in progress."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0"/>

                        <TextBlock x:Name="HashText"
                                   Text=""
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>

                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Safety boundary: checking for releases and downloading an asset do not apply AZOM settings. Review the release page, filename, version and hash before running anything you downloaded. Close ADT before manually launching an installer."/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <WrapPanel Grid.Row="1"
                   x:Name="UpdatesActions"
                   HorizontalAlignment="Right"
                   Margin="0,12,0,0">
            <Button x:Name="CancelDownloadButton"
                    Content="CANCEL DOWNLOAD"
                    Click="CancelDownload_Click"
                    IsEnabled="False"/>

            <Button x:Name="OpenReleaseButton"
                    Content="OPEN THIS RELEASE ON GITHUB"
                    Click="OpenRelease_Click"
                    IsEnabled="False"/>

            <Button x:Name="CloseButton"
                    Content="CLOSE"
                    Click="Close_Click"/>
        </WrapPanel>
    </Grid>
</Window>
