<Window x:Class="AtomicDriftTuner.UpdatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atomic Drift Tuner - Updates"
        Width="860" Height="760" MinWidth="700" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="UPDATES" FontSize="25" FontWeight="Bold"/>
            <TextBlock x:Name="CurrentVersionText"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,4,0,5"/>
            <TextBlock Text="Atomic checks the official T3ddyGrahams/AtomicDriftTuner GitHub Releases page only when you press Check for Updates. No automatic installation or hardware changes occur."
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="UPDATE CHANNEL" FontWeight="Bold"/>
                        <CheckBox x:Name="IncludePrereleaseBox"
                                  Content="Include public beta / pre-release versions"
                                  IsChecked="True" Margin="0,8,0,10"/>
                        <WrapPanel>
                            <Button x:Name="CheckButton" Content="CHECK FOR UPDATES" Click="Check_Click"
                                    FontWeight="Bold" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"/>
                            <Button Content="OPEN GITHUB RELEASES" Click="OpenReleases_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="CheckStatusText" Text="No update check has been run yet."
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="LATEST MATCHING RELEASE" FontWeight="Bold"/>
                        <TextBlock x:Name="ReleaseTitleText" Text="—" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/>
                        <TextBlock x:Name="ReleaseMetaText" Text="Check GitHub to load release details."
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <TextBox x:Name="ReleaseNotesBox" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 MinHeight="130" MaxHeight="220" Padding="9"
                                 Background="{DynamicResource InputBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="DOWNLOAD" FontWeight="Bold"/>
                        <TextBlock Text="Downloads are saved only after you choose a location. Atomic downloads to a temporary .part file first, then computes a local SHA-256 after completion. It does not run the installer for you."
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="InstallerNameText" Text="Installer: not loaded" FontWeight="Bold"/>
                                <TextBlock x:Name="InstallerSizeText" Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="DownloadInstallerButton" Content="DOWNLOAD INSTALLER"
                                    Click="DownloadInstaller_Click" IsEnabled="False"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="PortableNameText" Text="Portable ZIP: not loaded" FontWeight="Bold"/>
                                <TextBlock x:Name="PortableSizeText" Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="DownloadPortableButton" Content="DOWNLOAD PORTABLE ZIP"
                                    Click="DownloadPortable_Click" IsEnabled="False"/>
                        </Grid>

                        <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Height="16" Value="0"/>
                        <TextBlock x:Name="DownloadStatusText" Text="No download in progress."
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                        <TextBlock x:Name="HashText" Text="" FontFamily="Consolas" FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Safety boundary: the Updates window never applies AZOM settings, never touches SimHub/bridge files, never replaces the running Atomic executable, and never silently installs a downloaded release. Close Atomic and run the downloaded installer yourself when you choose to update."/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OpenReleaseButton" Content="OPEN THIS RELEASE ON GITHUB" Click="OpenRelease_Click" IsEnabled="False"/>
            <Button Content="CLOSE" Click="Close_Click"/>
        </WrapPanel>
    </Grid>
</Window>
